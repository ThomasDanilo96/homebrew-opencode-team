#compdef opencode-team

_opencode-team() {
  local context state state_descr
  local -a commands profiles
  profiles=('best:OpenAI premium profile' 'free:Anonymous MiMo free profile')
  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:command:->command' \
    '*::argument:->argument'
  case "$state" in
    command)
      commands=(
        'best:Start the BEST profile'
        'free:Start the FREE profile'
        'start:Start a selected profile'
        'setup:Provision shared tools and isolated V2 configs'
        'doctor:Check local setup without changing it'
        'config:Print a profile configuration path'
        'rollback:Restore a configuration backup'
        'version:Show package version'
        'help:Show usage'
      )
      _describe 'command' commands
      ;;
    argument)
      case "$words[2]" in
        start|config) _describe 'profile' profiles ;;
        best|free)
          _arguments '-s[Resume a native session]:session ID:' '*:native argument:_files'
          ;;
      esac
      ;;
  esac
}
