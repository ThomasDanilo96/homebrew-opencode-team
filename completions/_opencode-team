#compdef opencode-team

_opencode-team() {
  local context state state_descr
  local -a commands profiles cleanup_actions
  profiles=('best:OpenAI premium profile' 'free:Anonymous MiMo free profile')
  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:command:->command' \
    '*::argument:->argument'
  case "$state" in
    command)
      commands=(
        'best:Start the BEST profile'
        'free:Start the FREE profile'
        'start:Start a selected profile'
        'setup:Provision shared tools and isolated V2 configs'
        'doctor:Check local setup without changing it'
        'cleanup:Run safe maintenance or manage its macOS LaunchAgent'
        'config:Print a profile configuration path'
        'rollback:Restore a configuration backup'
        'version:Show package version'
        'help:Show usage'
      )
      _describe 'command' commands
      ;;
    argument)
      case "$words[2]" in
        cleanup)
          cleanup_actions=('enable:Schedule maintenance daily' 'disable:Stop scheduling and persist the preference' 'uninstall:Remove only the owned agent' 'status:Show scheduling preference' 'run:Run non-deleting session maintenance and safe caches' 'dry-run:Inspect maintenance without data changes' 'legacy-status:Inspect exact legacy jobs without changes' 'legacy-retire:Archive one recognized legacy job with explicit approval')
          _describe 'cleanup action' cleanup_actions
          ;;
        start|config) _describe 'profile' profiles ;;
        best|free)
          _arguments '-s[Resume a native session]:session ID:' '*:native argument:_files'
          ;;
      esac
      ;;
  esac
}
