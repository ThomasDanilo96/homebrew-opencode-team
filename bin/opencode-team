#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  LINK="$(readlink "$SOURCE")"
  case "$LINK" in
    /*) SOURCE="$LINK" ;;
    *) SOURCE="$SOURCE_DIR/$LINK" ;;
  esac
done
PACKAGE_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
VERSION_FILE="$PACKAGE_ROOT/VERSION"
SERENA_VERSION="1.7.0"

usage() {
  printf '%s\n' 'OpenCode Team' '' 'Usage:' \
    '  opencode-team setup' \
    '  opencode-team doctor' \
    '  opencode-team best [--resume SESSION]' \
    '  opencode-team go [--resume SESSION]' \
    '  opencode-team openai [--resume SESSION]' \
    '  opencode-team start <best|go|openai> [--resume SESSION]' \
    '  opencode-team version'
}

require_command() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    printf '  %-16s OK (%s)\n' "$name" "$(command -v "$name")"
    return 0
  fi
  printf '  %-16s MISSING\n' "$name"
  return 1
}

node_version_compatible() {
  local version major minor patch
  version="${1#v}"
  IFS=. read -r major minor patch _ <<< "$version"
  case "$major" in
    22) [ "$minor" -gt 22 ] || { [ "$minor" -eq 22 ] && [ "${patch:-0}" -ge 2 ]; } ;;
    24) [ "$minor" -gt 15 ] || { [ "$minor" -eq 15 ] && [ "${patch:-0}" -ge 0 ]; } ;;
    *) [ "$major" -ge 26 ] ;;
  esac
}

check_node() {
  local version
  if ! command -v node >/dev/null 2>&1; then
    printf '  %-16s MISSING\n' "node"
    return 1
  fi
  version="$(node --version)"
  if node_version_compatible "$version"; then
    printf '  %-16s %s COMPATIBLE\n' "node" "$version"
    return 0
  fi
  printf '  %-16s %s INCOMPATIBLE\n' "node" "$version"
  printf '  %-16s %s\n' "required" '22.22.2+ in 22.x, 24.15.0+ in 24.x, or >=26'
  return 1
}

serena_version_ok() {
  [[ "$1" == *"$SERENA_VERSION"* ]]
}

ensure_serena() {
  local tool_root="$DATA_ROOT/tools/serena" tool_bin="$DATA_ROOT/bin" serena_bin version
  serena_bin="$tool_bin/serena"
  mkdir -p "$tool_root" "$tool_bin" "$CACHE_ROOT/uv"
  if [ -x "$serena_bin" ]; then
    version="$($serena_bin --version 2>/dev/null || true)"
    if serena_version_ok "$version"; then
      export SERENA_BIN="$serena_bin"
      printf '  %-18s OK (cached, %s)\n' "Serena" "$SERENA_VERSION"
      return 0
    fi
  fi
  printf '  %-18s installing %s\n' "Serena" "$SERENA_VERSION"
  UV_TOOL_DIR="$tool_root" UV_TOOL_BIN_DIR="$tool_bin" UV_CACHE_DIR="$CACHE_ROOT/uv" \
    uv tool install --force --python python3 "serena-agent==$SERENA_VERSION" || return 1
  [ -x "$serena_bin" ] || { printf 'Serena install did not create %s\n' "$serena_bin" >&2; return 1; }
  version="$($serena_bin --version 2>/dev/null || true)"
  serena_version_ok "$version" || { printf 'Unsupported Serena version: %s\n' "$version" >&2; return 1; }
  export SERENA_BIN="$serena_bin"
  printf '  %-18s OK (%s)\n' "Serena" "$SERENA_VERSION"
}

ensure_codex() {
  if command -v codex >/dev/null 2>&1; then
    printf '  %-18s OK (%s)\n' "Codex" "$(command -v codex)"
    return 0
  fi
  printf '  %-18s missing; attempting Homebrew cask install\n' "Codex"
  require_command brew >/dev/null || return 1
  brew install --cask codex || return 1
  command -v codex >/dev/null 2>&1 || { printf 'Codex install did not provide codex\n' >&2; return 1; }
  printf '  %-18s OK (%s)\n' "Codex" "$(command -v codex)"
}

doctor() {
  local failed=0
  printf 'OpenCode Team doctor\n'
  printf '  OS               %s\n' "$(uname -s)"
  printf '  architecture     %s\n' "$(uname -m)"
  if [ -d "$PACKAGE_ROOT" ] && [ -f "$VERSION_FILE" ]; then
    printf '  package root      OK (%s)\n' "$PACKAGE_ROOT"
  else
    printf '  package root      MISSING (%s)\n' "$PACKAGE_ROOT"
    failed=1
  fi
  require_command brew || failed=1
  require_command opencode || failed=1
  check_node || failed=1
  require_command git || failed=1
  require_command python3 || failed=1
  require_command jq || failed=1
  require_command tmux || failed=1
  require_command curl || failed=1
  require_command uv || failed=1
  require_command rg || failed=1
  setup_roots
  if [ -x "$DATA_ROOT/bin/serena" ] && serena_version_ok "$($DATA_ROOT/bin/serena --version 2>/dev/null || true)"; then
    printf '  %-16s OK (%s)\n' "Serena" "$SERENA_VERSION"
  else
    printf '  %-16s NOT CONFIGURED\n' "Serena"
    failed=1
  fi
  if command -v codex >/dev/null 2>&1; then
    printf '  %-16s OK (OPENAI)\n' "Codex"
  else
    printf '  %-16s OPENAI UNAVAILABLE\n' "Codex"
    failed=1
  fi
  if command -v gh >/dev/null 2>&1; then
    printf '  %-16s OPTIONAL / available\n' "GitHub CLI"
  else
    printf '  %-16s OPTIONAL / missing\n' "GitHub CLI"
  fi
  for team in best go openai; do
    if [ -f "$CONFIG_ROOT/$team/team-runtime.conf" ]; then
      printf '  %-16s CONFIGURED\n' "$team profile"
    else
      printf '  %-16s NOT CONFIGURED\n' "$team profile"
      failed=1
    fi
  done
  return "$failed"
}

setup_roots() {
  if [ -n "${OPENCODE_TEAM_HOME:-}" ]; then
    CONFIG_ROOT="$OPENCODE_TEAM_HOME/config"
    DATA_ROOT="$OPENCODE_TEAM_HOME/data"
    STATE_ROOT="$OPENCODE_TEAM_HOME/state"
    CACHE_ROOT="$OPENCODE_TEAM_HOME/cache"
  else
    CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/opencode-team"
    DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/opencode-team"
    STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/opencode-team"
    CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-team"
  fi
}

install_dependencies() {
  local team="$1" dependency_root="$DATA_ROOT/dependencies/$team"
  local package_file="$PACKAGE_ROOT/teams/$team/package.json"
  local lock_file="$PACKAGE_ROOT/teams/$team/package-lock.json"
  local marker="$dependency_root/.installed-lock-sha256"
  local lock_hash
  lock_hash="$(shasum -a 256 "$lock_file" | cut -d' ' -f1)"
  if [ -f "$marker" ] && [ "$(< "$marker")" = "$lock_hash" ] && [ -d "$dependency_root/node_modules/oh-my-openagent" ]; then
    printf '  %-18s OK (cached)\n' "$team dependencies"
    return 0
  fi
  mkdir -p "$dependency_root"
  cp "$package_file" "$dependency_root/package.json"
  cp "$lock_file" "$dependency_root/package-lock.json"
  npm ci --ignore-scripts --no-audit --no-fund --prefix "$dependency_root"
  printf '%s\n' "$lock_hash" > "$marker"
  chmod 600 "$marker" "$dependency_root/package.json" "$dependency_root/package-lock.json"
  printf '  %-18s OK\n' "$team dependencies"
}

verify_best_omo() {
  local target="$DATA_ROOT/dependencies/best/node_modules/oh-my-openagent/dist/index.js"
  [ -f "$target" ] || { printf 'BEST OMO package missing\n' >&2; return 1; }
  "$PACKAGE_ROOT/teams/best/patch-omo-hook-timeout.sh" "$target"
  python3 "$PACKAGE_ROOT/teams/best/patch-omo-core.py" "$target"
  "$PACKAGE_ROOT/teams/best/patch-omo-isolation.sh" "$target"
  "$PACKAGE_ROOT/teams/best/verify-omo.sh" "$target"
  printf '  %-18s OK (patched and verified)\n' "best OMO"
}

verify_go_omo() {
  local target="$DATA_ROOT/dependencies/go/node_modules/oh-my-openagent/dist/index.js"
  [ -f "$target" ] || { printf 'GO OMO package missing\n' >&2; return 1; }
  python3 "$PACKAGE_ROOT/teams/go/patch-worker-done-v2.py" "$target"
  python3 "$PACKAGE_ROOT/teams/go/patch-routing.py" "$target"
  "$PACKAGE_ROOT/teams/go/verify-omo.sh" "$target"
  printf '  %-18s OK (patched and verified)\n' "go OMO"
}

render_template() {
  local template="$1" destination="$2"
  local temporary="${destination}.tmp.$$"
  python3 - "$template" "$temporary" <<'PY'
import os
import pathlib
import sys

template = pathlib.Path(sys.argv[1]).read_text()
values = {
    "@PACKAGE_ROOT@": os.environ["PACKAGE_ROOT"],
    "@CONFIG_ROOT@": os.environ["CONFIG_ROOT"],
    "@DATA_ROOT@": os.environ["DATA_ROOT"],
    "@STATE_ROOT@": os.environ["STATE_ROOT"],
    "@CACHE_ROOT@": os.environ["CACHE_ROOT"],
    "@OMO_PLUGIN@": os.environ.get("OMO_PLUGIN", "oh-my-openagent"),
    "@SERENA_BIN@": os.environ["SERENA_BIN"],
}
for marker, value in values.items():
    template = template.replace(marker, value)
pathlib.Path(sys.argv[2]).write_text(template)
PY
  if [ -f "$destination" ] && cmp -s "$temporary" "$destination"; then
    rm -f "$temporary"
  else
    mv "$temporary" "$destination"
  fi
}

setup() {
  require_command python3 >/dev/null || { printf 'python3 is required for setup\n' >&2; return 1; }
  require_command npm >/dev/null || { printf 'npm is required for setup\n' >&2; return 1; }
  check_node >/dev/null || { printf 'A compatible Node.js runtime is required for setup\n' >&2; return 1; }
  for command_name in opencode git jq tmux uv rg curl; do
    require_command "$command_name" >/dev/null || { printf '%s is required for setup\n' "$command_name" >&2; return 1; }
  done
  setup_roots
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT
  mkdir -p "$CONFIG_ROOT" "$DATA_ROOT" "$STATE_ROOT" "$CACHE_ROOT"
  chmod 700 "$CONFIG_ROOT" "$DATA_ROOT" "$STATE_ROOT" "$CACHE_ROOT"
  printf 'OpenCode Team setup\n'
  printf '  config root       %s\n' "$CONFIG_ROOT"
  printf '  data root         %s\n' "$DATA_ROOT"
  printf '  state root        %s\n' "$STATE_ROOT"
  printf '  cache root        %s\n' "$CACHE_ROOT"
  ensure_serena || return 1
  ensure_codex || return 1
  for team in best go openai; do
    export OMO_PLUGIN="$DATA_ROOT/dependencies/$team/node_modules/oh-my-openagent/dist/index.js"
    mkdir -p "$CONFIG_ROOT/$team/xdg-config" "$CONFIG_ROOT/$team/claude-config" "$DATA_ROOT/$team" "$STATE_ROOT/$team" "$CACHE_ROOT/$team"
    case "$team" in
      best) hook_source="$PACKAGE_ROOT/teams/best/patch-omo-hook-timeout.sh"; hook_name="patch-omo-hook-timeout.sh" ;;
      go) hook_source="$PACKAGE_ROOT/teams/go/patch-omo-task-completion.sh"; hook_name="patch-omo-task-completion.sh" ;;
      *) hook_source=""; hook_name="" ;;
    esac
    if [ -n "$hook_source" ]; then
      mkdir -p "$DATA_ROOT/$team/hooks"
      cp "$hook_source" "$DATA_ROOT/$team/hooks/$hook_name"
      chmod 700 "$DATA_ROOT/$team/hooks/$hook_name"
      if [ "$team" = "go" ]; then
        cp "$PACKAGE_ROOT/teams/go/patch-worker-done-v2.py" "$DATA_ROOT/$team/hooks/patch-worker-done-v2.py"
        cp "$PACKAGE_ROOT/teams/go/patch-routing.py" "$DATA_ROOT/$team/hooks/patch-routing.py"
        chmod 700 "$DATA_ROOT/$team/hooks/patch-worker-done-v2.py" "$DATA_ROOT/$team/hooks/patch-routing.py"
      fi
    fi
    render_template "$PACKAGE_ROOT/teams/$team/team-runtime.conf.template" "$CONFIG_ROOT/$team/team-runtime.conf"
    render_template "$PACKAGE_ROOT/teams/$team/opencode.jsonc.template" "$CONFIG_ROOT/$team/opencode.jsonc"
    if [ -f "$PACKAGE_ROOT/teams/$team/tui.json.template" ]; then
      mkdir -p "$CONFIG_ROOT/$team/xdg-config/opencode"
      render_template "$PACKAGE_ROOT/teams/$team/tui.json.template" "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
      chmod 600 "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" ]; then
      render_template "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" "$CONFIG_ROOT/$team/claude-config/settings.json"
      chmod 600 "$CONFIG_ROOT/$team/claude-config/settings.json"
    fi
    chmod 600 "$CONFIG_ROOT/$team/team-runtime.conf" "$CONFIG_ROOT/$team/opencode.jsonc"
    install_dependencies "$team"
    printf '  %-18s OK\n' "$team profile"
  done
  verify_best_omo
  verify_go_omo
  printf '  %-18s OK (package-local)\n' "openai OMO"
  printf 'Setup complete. No runtime was started.\n'
}

start_team() {
  local team="$1"
  shift
  case "$team" in
    best|go|openai) ;;
    *)
      printf 'Unknown team: %s (expected best, go, or openai)\n' "$team" >&2
      return 1
      ;;
  esac
  setup_roots
  local config_file="$CONFIG_ROOT/$team/team-runtime.conf"
  if [ ! -f "$config_file" ]; then
    printf '%s\n' 'OpenCode Team is not configured.' >&2
    printf '%s\n' '' 'Run:' '' '  opencode-team setup' >&2
    return 1
  fi
  [ -x "$PACKAGE_ROOT/core/bin/team-runtime" ] || {
    printf 'Runtime is missing or not executable: %s\n' "$PACKAGE_ROOT/core/bin/team-runtime" >&2
    return 1
  }
  exec env \
    -u TEAM_RUNTIME_INNER \
    -u RUN_ID \
    -u SESSION_MODE \
    -u RESUME_SESSION_ID \
    "$PACKAGE_ROOT/core/bin/team-runtime" --config "$config_file" "$@"
}

case "${1:-}" in
  --help|-h)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    usage
    ;;
  version)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    printf 'OpenCode Team %s\n' "$(< "$VERSION_FILE")"
    ;;
  doctor)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    doctor
    ;;
  setup)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    setup
    ;;
  start)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    shift
    start_team "$@"
    ;;
  best|go|openai)
    team="$1"
    shift
    start_team "$team" "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
