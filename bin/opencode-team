  setup_roots
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  node "$PACKAGE_ROOT/core/lib/runtime-lifecycle.mjs" accounting
}

