verify_go_omo() {
  local target="$DEPENDENCY_ROOT/go/node_modules/oh-my-openagent/dist/index.js"
  [ -f "$target" ] || { printf 'GO OMO package missing\n' >&2; return 1; }
  "$PYTHON_BIN" "$PACKAGE_ROOT/teams/go/patch-worker-done-v2.py" "$target"
  "$PYTHON_BIN" "$PACKAGE_ROOT/teams/go/patch-routing.py" "$target"
  "$PACKAGE_ROOT/teams/go/verify-omo.sh" "$target"
  printf '  %-18s OK (patched and verified)\n' "go OMO"
}

render_template() {
  local template="$1" destination="$2"
  local temporary status
  ensure_opencode_loaded || { printf 'Cannot render %s: a supported Homebrew OpenCode installation is required\n' "$template" >&2; return 1; }
  temporary="$(mktemp "${destination}.tmp.XXXXXX")" || return 1
  if "$PYTHON_BIN" - "$template" "$temporary" <<'PY'
import os
import pathlib
import sys

template = pathlib.Path(sys.argv[1]).read_text()
values = {
    "@PACKAGE_ROOT@": os.environ["PACKAGE_ROOT"],
    "@OPENCODE_BIN@": os.environ["OPENCODE_BIN"],
    "@PYTHON_BIN@": os.environ["PYTHON_BIN"],
    "@CONFIG_ROOT@": os.environ["CONFIG_ROOT"],
    "@DATA_ROOT@": os.environ["DATA_ROOT"],
    "@STATE_ROOT@": os.environ["STATE_ROOT"],
    "@CACHE_ROOT@": os.environ["CACHE_ROOT"],
    "@RUNTIME_ROOT@": os.environ["RUNTIME_ROOT"],
    "@DEPENDENCY_ROOT@": os.environ["DEPENDENCY_ROOT"],
    "@OMO_PLUGIN@": os.environ.get("OMO_PLUGIN", "oh-my-openagent"),
    "@SERENA_BIN@": os.environ["SERENA_BIN"],
    "@ECC_SOURCE@": os.path.join(os.environ["DATA_ROOT"], "best-ecc", "ecc"),
    "@DEEP_AUDIT_ECC_SOURCE@": os.path.join(os.environ["DATA_ROOT"], "deep-audit", "ecc"),
    "@DEEP_AUDIT_SERENA_HOME@": os.path.join(os.environ["DATA_ROOT"], "deep-audit", "serena"),
    "@REPORT_ROOT@": os.path.join(os.environ["DATA_ROOT"], "deep-audit", "reports"),
    "@OPENCODE_TOOL_MODULE@": pathlib.Path(os.path.join(os.environ["CONFIG_ROOT"], "deep-audit", "node_modules", "@opencode-ai", "plugin", "dist", "tool.js")).as_uri(),
}
for marker, value in values.items():
    template = template.replace(marker, value)
pathlib.Path(sys.argv[2]).write_text(template)
PY
  then
    :
  else
    status=$?
    rm -f "$temporary"
    return "$status"
  fi
  [ -f "$temporary" ] || return 1
  if [ -f "$destination" ]; then
    if cmp -s "$temporary" "$destination"; then
      rm -f "$temporary"
      return 0
    else
      status=$?
      if [ "$status" -ne 1 ]; then
        rm -f "$temporary"
        return "$status"
      fi
    fi
  fi
  mv "$temporary" "$destination" || { status=$?; rm -f "$temporary"; return "$status"; }
}

stale_generated_package_paths() {
  [ -n "$PYTHON_BIN" ] || return 0
  OPENCODE_TEAM_CONFIG_ROOT="$CONFIG_ROOT" OPENCODE_TEAM_PACKAGE_ROOT="$PACKAGE_ROOT" "$PYTHON_BIN" <<'PY'
import os
import pathlib
import json
import re
from urllib.parse import unquote, urlsplit

config_root = pathlib.Path(os.environ["OPENCODE_TEAM_CONFIG_ROOT"])
package_root = os.environ["OPENCODE_TEAM_PACKAGE_ROOT"]
package_segment = re.compile(r"/(?:[^/]*/)*(?:opencode-team|brew-opencode-team)(?:/|$)")
json_tokens = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/', re.DOTALL)
trailing_commas = re.compile(r'"(?:\\.|[^"\\])*"|,(?=\s*[}\]])', re.DOTALL)


def paths_in_json(value, key=""):
    # Permissions contain glob expressions, and prose is not a filesystem reference.
    if any(word in key.lower() for word in ("permission", "prompt", "instruction", "description", "content", "text")):
        return
    if isinstance(value, dict):
        for child_key, child_value in value.items():
            yield from paths_in_json(child_value, child_key)
    elif isinstance(value, list):
        for child_value in value:
            yield from paths_in_json(child_value, key)
    elif isinstance(value, str):
        yield value


def jsonc_values(text):
    text = json_tokens.sub(lambda match: match.group() if match.group().startswith('"') else "", text)
    text = trailing_commas.sub(lambda match: "" if match.group().startswith(",") else match.group(), text)
    return paths_in_json(json.loads(text))


def filesystem_path(value):
    value = value.strip()
    if value.startswith("file://"):
        url = urlsplit(value)
        if url.netloc not in ("", "localhost"):
            return None
        value = unquote(url.path)
    # A complete path value, not a substring of a prompt or a glob permission.
    if not value.startswith("/") or any(char in value for char in "*?[]{}\n\r"):
        return None
    match = package_segment.search(value)
    if not match:
        return None
    # Only package-owned artifact paths are generated references. An unrelated
    # missing path beneath a directory named opencode-team is not stale config.
    suffix = value[match.end():]
    if not (suffix.startswith(("teams/", "core/", "shared/", "bin/")) or suffix == "VERSION"):
        return None
    return value


for path in sorted(config_root.glob("*/**/*")):
    if not path.is_file() or path.name not in {"team-runtime.conf", "opencode.jsonc", "tui.json", "settings.json"}:
        continue
    text = path.read_text(errors="replace")
    if path.name == "team-runtime.conf":
        values = (line.partition("=")[2].strip().strip('"\'') for line in text.splitlines()
                  if re.match(r"^[A-Za-z_][A-Za-z_0-9]*=", line))
    else:
        try:
            values = list(jsonc_values(text))
        except ValueError:
            continue
    for value in values:
        candidate = filesystem_path(value)
        if candidate is None:
            continue
        # ECC skill trees are provisioned separately by their profile setup commands.
        if "/best-ecc/ecc/" in candidate:
            continue
        if "/deep-audit/ecc/" in candidate:
            continue
        if candidate == package_root or candidate.startswith(package_root + "/"):
            continue
        if not pathlib.Path(candidate).exists():
            print(f"{path}: {candidate}")
PY
}

refresh_generated_configs() {
  local team dependency_team hook_source hook_name
  load_opencode || { printf 'Cannot refresh stale package config: a supported OpenCode installation is required\n' >&2; return 1; }
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  SERENA_BIN="${SERENA_BIN:-$DATA_ROOT/bin/serena}"
  export SERENA_BIN
  [ -x "$SERENA_BIN" ] || {
    printf 'Cannot refresh stale package config: Serena is missing; run setup\n' >&2
    return 1
  }
  for team in best best-ecc free go openai daily; do
    dependency_team="$team"
    [ "$team" = daily ] && dependency_team=openai
    [ "$team" = free ] && dependency_team=best
    [ "$team" = best-ecc ] && dependency_team=best
    export OMO_PLUGIN="$DEPENDENCY_ROOT/$dependency_team/node_modules/oh-my-openagent/dist/index.js"
    [ -f "$OMO_PLUGIN" ] || {
      printf 'Cannot refresh stale package config: OMO plugin is missing: %s\n' "$OMO_PLUGIN" >&2
      return 1
    }
    ensure_profile_roots "$team"
    mkdir -p "$CONFIG_ROOT/$team/xdg-config/opencode"
    case "$team" in
      best|free) hook_source="$PACKAGE_ROOT/teams/best/patch-omo-hook-timeout.sh"; hook_name=patch-omo-hook-timeout.sh ;;
      go) hook_source="$PACKAGE_ROOT/teams/go/patch-omo-task-completion.sh"; hook_name=patch-omo-task-completion.sh ;;
      *) hook_source=""; hook_name="" ;;
    esac
    if [ -n "$hook_source" ]; then
      mkdir -p "$DATA_ROOT/$team/hooks"
      cp "$hook_source" "$DATA_ROOT/$team/hooks/$hook_name"
      chmod 700 "$DATA_ROOT/$team/hooks/$hook_name"
    fi
    render_template "$PACKAGE_ROOT/teams/$team/team-runtime.conf.template" "$CONFIG_ROOT/$team/team-runtime.conf" || return 1
    render_template "$PACKAGE_ROOT/teams/$team/opencode.jsonc.template" "$CONFIG_ROOT/$team/opencode.jsonc" || return 1
    if [ -f "$PACKAGE_ROOT/teams/$team/oh-my-openagent.jsonc.template" ]; then
      render_template "$PACKAGE_ROOT/teams/$team/oh-my-openagent.jsonc.template" "$CONFIG_ROOT/$team/xdg-config/opencode/oh-my-openagent.jsonc" || return 1
      chmod 600 "$CONFIG_ROOT/$team/xdg-config/opencode/oh-my-openagent.jsonc"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/omo.jsonc.template" ]; then
      mkdir -p "$DATA_ROOT/$team/.omo"
      render_template "$PACKAGE_ROOT/teams/$team/omo.jsonc.template" "$DATA_ROOT/$team/.omo/omo.jsonc" || return 1
      chmod 600 "$DATA_ROOT/$team/.omo/omo.jsonc"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/tui.json.template" ]; then
      render_template "$PACKAGE_ROOT/teams/$team/tui.json.template" "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json" || return 1
      chmod 600 "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" ]; then
      render_template "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" "$CONFIG_ROOT/$team/claude-config/settings.json" || return 1
      chmod 600 "$CONFIG_ROOT/$team/claude-config/settings.json"
    fi
    chmod 600 "$CONFIG_ROOT/$team/team-runtime.conf" "$CONFIG_ROOT/$team/opencode.jsonc"
  done
  render_deep_audit_profile || return 1
}

ensure_generated_config_current() {
  setup_roots
  [ -d "$CONFIG_ROOT" ] || return 0
  if ! managed_python_healthy; then
    printf 'Cannot refresh stale package config: managed Python is missing; run setup\n' >&2
    return 1
  fi
  export PYTHON_BIN OPENCODE_TEAM_PYTHON
  local stale config_missing=0 team
  stale="$(stale_generated_package_paths)"
  for team in best best-ecc deep-audit free go openai daily; do
    [ -f "$CONFIG_ROOT/$team/team-runtime.conf" ] || continue
    grep -q '^OPENCODE_TEAM_PYTHON=' "$CONFIG_ROOT/$team/team-runtime.conf" || config_missing=1
    grep -q '^RUNTIME_ROOT=' "$CONFIG_ROOT/$team/team-runtime.conf" || config_missing=1
    grep -q '^PERSISTENT_DATA_ROOT=' "$CONFIG_ROOT/$team/team-runtime.conf" || config_missing=1
  done
  if ! "$PYTHON_BIN" - "$CONFIG_ROOT" <<'PY'
import json
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
json_tokens = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/', re.DOTALL)
trailing_commas = re.compile(r'"(?:\\.|[^"\\])*"|,(?=\s*[}\]])', re.DOTALL)
for path in root.glob("*/opencode.jsonc"):
    source = path.read_text()
    source = json_tokens.sub(lambda match: match.group() if match.group().startswith('"') else "", source)
    source = trailing_commas.sub(lambda match: "" if match.group().startswith(",") else match.group(), source)
    json.loads(source)
PY
  then
    config_missing=1
  fi
  if [ -f "$CONFIG_ROOT/best/team-runtime.conf" ] && [ -f "$PACKAGE_ROOT/teams/best/omo.jsonc.template" ] && [ ! -f "$DATA_ROOT/best/.omo/omo.jsonc" ]; then
    config_missing=1
  fi
  if [ -f "$CONFIG_ROOT/best-ecc/team-runtime.conf" ] && [ -f "$PACKAGE_ROOT/teams/best-ecc/omo.jsonc.template" ] && [ ! -f "$DATA_ROOT/best-ecc/.omo/omo.jsonc" ]; then
    config_missing=1
  fi
  if [ -f "$CONFIG_ROOT/deep-audit/team-runtime.conf" ] && [ ! -f "$CONFIG_ROOT/deep-audit/xdg-config/opencode/tui.json" ]; then
    config_missing=1
  fi
  if [ -n "$stale" ] || [ "$config_missing" -eq 1 ]; then
    printf 'Refreshing stale package-owned generated configuration\n' >&2
    refresh_generated_configs || {
      printf '%s\n' "$stale" >&2
      return 1
    }
  fi
}

install_time_machine_exclusions() {
  [ "$(uname -s)" = Darwin ] || return 0
  command -v tmutil >/dev/null 2>&1 || return 0
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  for team in best best-ecc free go openai daily; do
    mkdir -p "$DATA_ROOT/$team/playwright/output"
  done
  mkdir -p "$DATA_ROOT/deep-audit/playwright/output"
  local result
  if result="$(node "$PACKAGE_ROOT/core/lib/runtime-lifecycle.mjs" time-machine-exclude --apply 2>&1)"; then
    printf '  %-18s OK (runtime/dependencies/Playwright outputs)\n' "Time Machine"
  else
    printf '  %-18s FAILED (%s)\n' "Time Machine" "$result" >&2
  fi
}

install_terminal_notifier() {
  [ "$(uname -s)" = Darwin ] || return 0
  if [ "${CI:-}" = true ]; then
    printf '  %-18s SKIPPED (CI has no notification permission prompt)\n' "macOS notifications"
    return 0
  fi

  local prefix source_app target_app notifier_bin first_install=0
  prefix="$(brew --prefix terminal-notifier 2>/dev/null)" || {
    printf 'Cannot locate the Homebrew terminal-notifier installation\n' >&2
    return 1
  }
  source_app="$prefix/terminal-notifier.app"
  target_app="$HOME/Applications/terminal-notifier.app"
  notifier_bin="$target_app/Contents/MacOS/terminal-notifier"
  if [ ! -x "$source_app/Contents/MacOS/terminal-notifier" ]; then
    printf 'terminal-notifier app bundle is missing: %s\n' "$source_app" >&2
    return 1
  fi
  if [ -e "$target_app" ] && [ ! -d "$target_app/Contents/MacOS" ]; then
    printf 'Refusing to replace an unrelated path: %s\n' "$target_app" >&2
    return 1
  fi
  [ -d "$target_app" ] || first_install=1
  mkdir -p "$HOME/Applications"
  ditto "$source_app" "$target_app" || return 1
  if ! open -a "$target_app" >/dev/null 2>&1; then
    printf '  macOS notifications: Launch Services registration failed; check System Settings → Notifications.\n' >&2
  fi
  export OPENCODE_TEAM_TERMINAL_NOTIFIER="$notifier_bin"
  if [ "$first_install" -eq 1 ]; then
    if "$notifier_bin" -title "OpenCode Team" -message "Le notifiche di OpenCode Team sono pronte."; then
      printf '  %-18s OK (registered; notification permission requested)\n' "macOS notifications"
    else
      printf '%s\n' '  macOS notifications: enable terminal-notifier in System Settings → Notifications.' >&2
    fi
  else
    printf '  %-18s OK (registered)\n' "macOS notifications"
  fi
}

setup() {
  local native_runtime
  require_command npm >/dev/null || { printf 'npm is required for setup\n' >&2; return 1; }
  check_node >/dev/null || { printf 'A compatible Node.js runtime is required for setup\n' >&2; return 1; }
  for command_name in git jq tmux uv rg curl terminal-notifier; do
    require_command "$command_name" >/dev/null || { printf '%s is required for setup\n' "$command_name" >&2; return 1; }
  done
  setup_roots
  ensure_opencode || {
    printf 'A supported Homebrew OpenCode installation is required for setup\n' >&2
    return 1
  }
  install_terminal_notifier || return 1
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  mkdir -p "$CONFIG_ROOT" "$DATA_ROOT" "$STATE_ROOT" "$CACHE_ROOT" "$RUNTIME_ROOT" "$DEPENDENCY_ROOT"
  chmod 700 "$CONFIG_ROOT" "$DATA_ROOT" "$STATE_ROOT" "$CACHE_ROOT" "$RUNTIME_ROOT" "$DEPENDENCY_ROOT"
  remove_legacy_shared_oauth_copies
  printf 'OpenCode Team setup\n'
  printf '  config root       %s\n' "$CONFIG_ROOT"
  printf '  data root         %s\n' "$DATA_ROOT"
  printf '  state root        %s\n' "$STATE_ROOT"
  printf '  cache root        %s\n' "$CACHE_ROOT"
  printf '  runtime root      %s\n' "$RUNTIME_ROOT"
  printf '  dependency root   %s\n' "$DEPENDENCY_ROOT"
  if [ "${OPENCODE_TEAM_TEST_SKIP_TIME_MACHINE:-0}" = "1" ]; then
    printf '  %-18s SKIPPED (isolated profile test)\n' "Time Machine"
  else
    install_time_machine_exclusions
  fi
  ensure_python || return 1
  ensure_serena || return 1
  ensure_codex || return 1
  for team in best best-ecc free go openai daily; do
    dependency_team="$team"
    [ "$team" = daily ] && dependency_team=openai
    [ "$team" = free ] && dependency_team=best
    [ "$team" = best-ecc ] && dependency_team=best
    export OMO_PLUGIN="$DEPENDENCY_ROOT/$dependency_team/node_modules/oh-my-openagent/dist/index.js"
    ensure_profile_roots "$team"
    case "$team" in
      best|best-ecc|free) hook_source="$PACKAGE_ROOT/teams/best/patch-omo-hook-timeout.sh"; hook_name="patch-omo-hook-timeout.sh" ;;
      go) hook_source="$PACKAGE_ROOT/teams/go/patch-omo-task-completion.sh"; hook_name="patch-omo-task-completion.sh" ;;
      *) hook_source=""; hook_name="" ;;
    esac
    if [ -n "$hook_source" ]; then
      mkdir -p "$DATA_ROOT/$team/hooks"
      cp "$hook_source" "$DATA_ROOT/$team/hooks/$hook_name"
      chmod 700 "$DATA_ROOT/$team/hooks/$hook_name"
      if [ "$team" = "go" ]; then
        cp "$PACKAGE_ROOT/teams/go/patch-worker-done-v2.py" "$DATA_ROOT/$team/hooks/patch-worker-done-v2.py"
        cp "$PACKAGE_ROOT/teams/go/patch-routing.py" "$DATA_ROOT/$team/hooks/patch-routing.py"
        chmod 700 "$DATA_ROOT/$team/hooks/patch-worker-done-v2.py" "$DATA_ROOT/$team/hooks/patch-routing.py"
      fi
    fi
    render_template "$PACKAGE_ROOT/teams/$team/team-runtime.conf.template" "$CONFIG_ROOT/$team/team-runtime.conf"
    render_template "$PACKAGE_ROOT/teams/$team/opencode.jsonc.template" "$CONFIG_ROOT/$team/opencode.jsonc"
    if [ -f "$PACKAGE_ROOT/teams/$team/oh-my-openagent.jsonc.template" ]; then
      mkdir -p "$CONFIG_ROOT/$team/xdg-config/opencode"
      render_template "$PACKAGE_ROOT/teams/$team/oh-my-openagent.jsonc.template" "$CONFIG_ROOT/$team/xdg-config/opencode/oh-my-openagent.jsonc"
      chmod 600 "$CONFIG_ROOT/$team/xdg-config/opencode/oh-my-openagent.jsonc"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/omo.jsonc.template" ]; then
      mkdir -p "$DATA_ROOT/$team/.omo"
      render_template "$PACKAGE_ROOT/teams/$team/omo.jsonc.template" "$DATA_ROOT/$team/.omo/omo.jsonc"
      chmod 600 "$DATA_ROOT/$team/.omo/omo.jsonc"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/tui.json.template" ]; then
      mkdir -p "$CONFIG_ROOT/$team/xdg-config/opencode"
      render_template "$PACKAGE_ROOT/teams/$team/tui.json.template" "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
      chmod 600 "$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
    fi
    if [ -f "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" ]; then
      render_template "$PACKAGE_ROOT/teams/$team/claude-config/settings.json.template" "$CONFIG_ROOT/$team/claude-config/settings.json"
      chmod 600 "$CONFIG_ROOT/$team/claude-config/settings.json"
    fi
    chmod 600 "$CONFIG_ROOT/$team/team-runtime.conf" "$CONFIG_ROOT/$team/opencode.jsonc"
    install_dependencies "$team"
    printf '  %-18s OK\n' "$team profile"
  done
  if [ "${OPENCODE_TEAM_TEST_SKIP_ECC_SETUP:-0}" = "1" ]; then
    printf '  %-18s SKIPPED (isolated setup test)\n' "best-ecc assets"
  else
    bash "$PACKAGE_ROOT/teams/best-ecc/setup-ecc.sh" "$DATA_ROOT/best-ecc" || return 1
    printf '  %-18s OK (pinned skills and hooks installed)\n' "best-ecc assets"
  fi
  if [ "${OPENCODE_TEAM_TEST_SKIP_ECC_SETUP:-0}" = "1" ]; then
    ensure_profile_roots deep-audit
    render_deep_audit_profile || return 1
    printf '  %-18s SKIPPED (isolated setup test; pinned ECC assets not provisioned)\n' "deep-audit assets"
  else
    setup_deep_audit_profile || return 1
  fi
  native_runtime="$(resolve_native_runtime)" || return 1
  prepare_best_native "$native_runtime" || return 1
  verify_best_omo
  verify_best_native
  verify_go_omo
  printf '  %-18s OK (package-local)\n' "openai OMO"
  install_maintenance || return 1
  printf 'Setup complete. No runtime was started.\n'
}

