start_team() {
  local team="$1"
  shift
  case "$team" in
    best|go|openai|daily) ;;
    *)
      printf 'Unknown team: %s (expected best, go, openai, or daily)\n' "$team" >&2
      return 1
      ;;
  esac
  setup_roots
  ensure_profile_roots "$team"
  ensure_generated_config_current || return 1
  local config_file="$CONFIG_ROOT/$team/team-runtime.conf"
  if [ ! -f "$config_file" ]; then
    printf '%s\n' 'OpenCode Team is not configured.' >&2
    printf '%s\n' '' 'Run:' '' '  opencode-team setup' >&2
    return 1
  fi
  [ -x "$PACKAGE_ROOT/core/bin/team-runtime" ] || {
    printf 'Runtime is missing or not executable: %s\n' "$PACKAGE_ROOT/core/bin/team-runtime" >&2
    return 1
  }
  if [ "${TEAM_RUNTIME_HEADLESS:-}" = 1 ]; then
    exec env \
      TEAM_RUNTIME_INNER=1 \
      RUN_ID="$("$PYTHON_BIN" -c "import secrets; print(secrets.token_hex(4))")" \
      SESSION_MODE=new \
      RESUME_SESSION_ID="" \
      "$PACKAGE_ROOT/core/bin/team-runtime" --config "$config_file" "$@"
  fi
  exec env \
    -u TEAM_RUNTIME_INNER \
    -u RUN_ID \
    -u SESSION_MODE \
    -u RESUME_SESSION_ID \
    "$PACKAGE_ROOT/core/bin/team-runtime" --config "$config_file" "$@"
}

case "${1:-}" in
  --help|-h)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    usage
    ;;
  version)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    printf 'OpenCode Team %s\n' "$(< "$VERSION_FILE")"
    ;;
  daily-report)
    shift
    setup_roots
    exec env OPENAI_TEAM_STATE_ROOT="$DATA_ROOT/daily/state/team" node "$PACKAGE_ROOT/teams/daily/bin/daily-report.mjs" "$@"
    ;;
  daily-benchmark)
    shift
    if [ "${1:-}" = execute ]; then
      exec node "$PACKAGE_ROOT/benchmarks/daily/execute.mjs" "$@"
    fi
    exec node "$PACKAGE_ROOT/benchmarks/daily/runner.mjs" "$@"
    ;;
  runtime-status)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    runtime_status
    ;;
  runtime-readiness)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    runtime_readiness
    ;;
  runtime-gc)
    shift
    runtime_gc "$@"
    ;;
  storage-accounting)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    storage_accounting
    ;;
  runtime-quota)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    runtime_quota
    ;;
  time-machine-exclude)
    shift
    time_machine_exclude "$@"
    ;;
  time-machine-status)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    time_machine_status
    ;;
  legacy-classify)
    shift
    legacy_classify "$@"
    ;;
  doctor)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    doctor
    ;;
  setup)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    setup
    ;;
  maintenance)
    shift
    maintenance_command "$@"
    ;;
  start)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    shift
    start_team "$@"
    ;;
  best|go|openai|daily)
    team="$1"
    shift
    start_team "$team" "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
