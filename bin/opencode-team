#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  LINK="$(readlink "$SOURCE")"
  case "$LINK" in
    /*) SOURCE="$LINK" ;;
    *) SOURCE="$SOURCE_DIR/$LINK" ;;
  esac
done
PACKAGE_ROOT="$(cd -L "$(dirname "$SOURCE")/.." && pwd -L)"
VERSION_FILE="$PACKAGE_ROOT/VERSION"
SERENA_VERSION="1.7.0"
PYTHON_VERSION="3.13"
OPENCODE_MIN_VERSION="1.18.30"

usage() {
  printf '%s\n' 'OpenCode Team' '' 'Usage:' \
    '  opencode-team setup' \
    '  opencode-team doctor' \
    '  opencode-team best [--resume SESSION] (OpenCode BEST profile)' \
    '  opencode-team best-ecc [--resume SESSION] (isolated BEST + ECC profile)' \
    '  opencode-team best-ecc-setup (install pinned ECC skills and agents)' \
    '  opencode-team deep-audit [--resume SESSION] [TARGET]' \
    '  opencode-team deep-audit-setup' \
    '  opencode-team deep-audit-doctor' \
    '  opencode-team deep-audit-report [options]' \
    '  opencode-team free [--resume SESSION] (BEST profile with OpenCode Zen free models)' \
    '  opencode-team best-opencode [--resume SESSION] (alias for best)' \
    '  opencode-team best-native [OMO OPTIONS]' \
    '  opencode-team best-native-setup [--dry-run|--yes]' \
    '  opencode-team go [--resume SESSION]' \
    '  opencode-team openai [--resume SESSION]' \
    '  opencode-team daily [--resume SESSION]' \
    '  opencode-team start <best|best-ecc|deep-audit|free|best-opencode|best-native|go|openai|daily> [options]' \
    '  opencode-team daily-report [--markdown]' \
    '  opencode-team daily-benchmark <list|validate|prepare|report|execute> [options]' \
    '  opencode-team runtime-status' \
    '  opencode-team runtime-history' \
    '  opencode-team runtime-readiness' \
    '  opencode-team runtime-gc [--apply]' \
    '  opencode-team storage-accounting' \
    '  opencode-team runtime-quota' \
    '  opencode-team time-machine-exclude [--apply]' \
    '  opencode-team time-machine-status' \
    '  opencode-team legacy-classify [path ...]' \
    '  opencode-team maintenance <best-tool-output-gc|best-retention|openai-retention|runtime-gc|version-check|status>' \
    '  opencode-team version'
}

require_command() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    printf '  %-16s OK (%s)\n' "$name" "$(command -v "$name")"
    return 0
  fi
  printf '  %-16s MISSING\n' "$name"
  return 1
}

node_version_compatible() {
  local version major minor patch
  version="${1#v}"
  IFS=. read -r major minor patch _ <<< "$version"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ && "$patch" =~ ^[0-9]+$ ]] || return 1
  case "$major" in
    22) [ "$minor" -gt 22 ] || { [ "$minor" -eq 22 ] && [ "${patch:-0}" -ge 2 ]; } ;;
    24) [ "$minor" -gt 15 ] || { [ "$minor" -eq 15 ] && [ "${patch:-0}" -ge 0 ]; } ;;
    *) [ "$major" -ge 26 ] ;;
  esac
}

check_node() {
  local version node_bin
  if ! command -v node >/dev/null 2>&1; then
    printf '  %-16s MISSING\n' "node"
    return 1
  fi
  node_bin="$(command -v node)"
  # A --version shim (or Bun masquerading as node) cannot run our Node scripts.
  version="$("$node_bin" -p 'process.release.name === "node" ? process.versions.node : ""' 2>/dev/null)" || {
    printf '  %-16s INVALID (not a working Node.js runtime)\n' "node"
    return 1
  }
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    printf '  %-16s INVALID (not a working Node.js runtime)\n' "node"
    return 1
  }
  if node_version_compatible "$version"; then
    printf '  %-16s %s COMPATIBLE\n' "node" "$version"
    return 0
  fi
  printf '  %-16s %s INCOMPATIBLE\n' "node" "$version"
  printf '  %-16s %s\n' "required" '22.22.2+ in 22.x, 24.15.0+ in 24.x, or >=26'
  return 1
}

resolve_native_runtime() {
  local candidate package_name version major minor
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64) package_name=@oven/bun-darwin-aarch64 ;;
    Darwin:x86_64) package_name=@oven/bun-darwin-x64 ;;
    Linux:aarch64|Linux:arm64)
      if command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | rg -qi musl; then package_name=@oven/bun-linux-aarch64-musl; else package_name=@oven/bun-linux-aarch64; fi
      ;;
    Linux:x86_64)
      if command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | rg -qi musl; then package_name=@oven/bun-linux-x64-musl; else package_name=@oven/bun-linux-x64; fi
      ;;
    MINGW*:x86_64) package_name=@oven/bun-windows-x64 ;;
    MINGW*:aarch64|MINGW*:arm64) package_name=@oven/bun-windows-aarch64 ;;
    *) package_name="" ;;
  esac
  if [ -n "$package_name" ]; then
    candidate="$DEPENDENCY_ROOT/best/node_modules/$package_name/bin/bun"
    [[ "$package_name" == @oven/bun-windows-* ]] && candidate="${candidate}.exe"
    if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  candidate="$(command -v bun 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    version="$("$candidate" --version 2>/dev/null || true)"
    IFS=. read -r major minor _ <<< "$version"
    if [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] && { [ "$major" -gt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -ge 4 ]; }; } && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  candidate="$(command -v node 2>/dev/null || true)"
  if [ -n "$candidate" ]; then
    version="$("$candidate" --version 2>/dev/null || true)"
    major="${version#v}"
    major="${major%%.*}"
    if [[ "$major" =~ ^[0-9]+$ ]] && [ "$major" -ge 24 ] && "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  printf '%s\n' 'BEST Native requires Bun 1.4+ (bundled by setup) or Node.js >=24.' >&2
  return 1
}

serena_version_ok() {
  [[ "$1" == *"$SERENA_VERSION"* ]]
}

validate_profile_config() {
  local team="$1" config_file="$CONFIG_ROOT/$1/opencode.jsonc" xdg_root="$CONFIG_ROOT/$1/xdg-config"
  ensure_opencode_loaded || { printf '  %-16s INVALID (supported Homebrew OpenCode is unavailable)\n' "$team profile"; return 1; }
  validate_generated_surface "$team" || return 1
  if ! OPENCODE_CONFIG="$config_file" \
    OPENCODE_CONFIG_DIR="$(dirname "$config_file")" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    XDG_CONFIG_HOME="$xdg_root" \
    XDG_DATA_HOME="$DATA_ROOT/$team/data" \
    XDG_CACHE_HOME="$CACHE_ROOT/$team" \
    XDG_STATE_HOME="$STATE_ROOT/$team" \
    "$OPENCODE_BIN" debug config >/dev/null 2>&1; then
    printf '  %-16s INVALID (OpenCode rejected generated config)\n' "$team profile"
    return 1
  fi
  if [ "$team" = daily ]; then
    validate_omo_config "$team" || return 1
  fi
  printf '  %-16s CONFIGURED\n' "$team profile"
}

resolve_opencode() {
  local brew_prefix candidate
  if command -v brew >/dev/null 2>&1; then
    brew_prefix="$(HOMEBREW_NO_INSTALL_CLEANUP=1 brew --prefix opencode 2>/dev/null || true)"
    [ -n "$brew_prefix" ] || return 1
    candidate="$brew_prefix/bin/opencode"
    if [ -f "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  return 1
}

opencode_version_supported() {
  local version major minor patch min_major min_minor min_patch
  version="$1"
  version="${version#v}"
  IFS=. read -r major minor patch _ <<< "$version"
  IFS=. read -r min_major min_minor min_patch _ <<< "$OPENCODE_MIN_VERSION"
  [ "${major:-0}" -gt "$min_major" ] || {
    [ "${major:-0}" -eq "$min_major" ] && {
      [ "${minor:-0}" -gt "$min_minor" ] || {
        [ "${minor:-0}" -eq "$min_minor" ] && [ "${patch:-0}" -ge "$min_patch" ]
      }
    }
  }
}

validate_opencode() {
  local executable="$1" version
  [ -x "$executable" ] || return 1
  version="$("$executable" --version 2>/dev/null)" || return 1
  [[ "$version" =~ ^(opencode[[:blank:]]+)?v?([0-9]+\.[0-9]+\.[0-9]+)$ ]] || return 1
  version="${BASH_REMATCH[2]}"
  opencode_version_supported "$version" || return 1
  OPENCODE_VERSION="$version"
  export OPENCODE_VERSION
}

load_opencode() {
  OPENCODE_BIN="$(resolve_opencode 2>/dev/null)" || return 1
  [ -n "$OPENCODE_BIN" ] && validate_opencode "$OPENCODE_BIN" || return 1
  export OPENCODE_BIN
}

ensure_opencode_loaded() {
  # Never trust an ambient executable over the Homebrew-managed installation.
  if [ -n "${OPENCODE_BIN:-}" ] && [ "$OPENCODE_BIN" = "$(resolve_opencode 2>/dev/null || true)" ] && validate_opencode "$OPENCODE_BIN"; then
    export OPENCODE_BIN
    return 0
  fi
  load_opencode
}

ensure_opencode() {
  if ! load_opencode; then
    require_command brew >/dev/null || return 1
    printf '  %-18s missing or unsupported; installing Homebrew core OpenCode\n' "OpenCode"
    HOMEBREW_NO_INSTALL_CLEANUP=1 brew install opencode || return 1
    load_opencode || return 1
  fi
  printf '  %-18s OK (%s, %s)\n' "OpenCode" "$OPENCODE_VERSION" "$OPENCODE_BIN"
}

validate_generated_surface() {
  local team="$1" config_file="$CONFIG_ROOT/$team/opencode.jsonc" tui_file="$CONFIG_ROOT/$team/xdg-config/opencode/tui.json"
  local key value
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      PRE_SERVER_HOOK|RUNTIME_ENV_HOOK)
        if [ -n "$value" ] && [ ! -f "$value" ]; then
          printf '  %-16s INVALID (%s does not exist: %s)\n' "$team profile" "$key" "$value"
          return 1
        fi
        if [ "$key" = PRE_SERVER_HOOK ] && [ -n "$value" ] && [ ! -x "$value" ]; then
          printf '  %-16s INVALID (%s is not executable: %s)\n' "$team profile" "$key" "$value"
          return 1
        fi
        ;;
    esac
  done < "$CONFIG_ROOT/$team/team-runtime.conf"
  if [ ! -f "$tui_file" ]; then
    printf '  %-16s INVALID (TUI config missing: %s)\n' "$team profile" "$tui_file"
    return 1
  fi
  GENERATED_CONFIG_FILE="$config_file" GENERATED_TUI_FILE="$tui_file" node <<'NODE'
const fs = require("node:fs");
const files = [process.env.GENERATED_CONFIG_FILE, process.env.GENERATED_TUI_FILE];
for (const file of files) {
  let value;
  try { value = JSON.parse(fs.readFileSync(file, "utf8")); }
  catch (error) { console.error(`${file}: ${error.message}`); process.exit(1); }
  for (const plugin of value.plugin ?? []) {
    if (plugin.startsWith("/") && !fs.existsSync(plugin)) {
      console.error(`${file}: missing plugin: ${plugin}`);
      process.exit(1);
    }
  }
}
NODE
}

validate_omo_config() {
  local team="$1" dependency_team=openai plugin_cli report
  plugin_cli="$DEPENDENCY_ROOT/$dependency_team/node_modules/oh-my-openagent/dist/cli-node/index.js"
  report="$CACHE_ROOT/$team/omo-doctor.json"
  [ -f "$plugin_cli" ] || {
    printf '  %-16s INVALID (OMO parser missing: %s)\n' "$team OMO config" "$plugin_cli"
    return 1
  }
  mkdir -p "$(dirname "$report")"
  env -u OMO_PROFILE \
    OPENCODE_CONFIG="$CONFIG_ROOT/$team/opencode.jsonc" \
    OPENCODE_CONFIG_DIR="$CONFIG_ROOT/$team" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    XDG_CONFIG_HOME="$CONFIG_ROOT/$team/xdg-config" \
    XDG_DATA_HOME="$DATA_ROOT/$team/data" \
    XDG_CACHE_HOME="$CACHE_ROOT/$team" \
    XDG_STATE_HOME="$STATE_ROOT/$team" \
    node "$plugin_cli" doctor --platform opencode --json >"$report" 2>/dev/null || true
  if ! OMO_DOCTOR_REPORT="$report" node <<'NODE'
const fs = require("node:fs");
const report = JSON.parse(fs.readFileSync(process.env.OMO_DOCTOR_REPORT, "utf8"));
const invalid = report.results?.find((result) => result.name === "Configuration" && result.message?.startsWith("Configuration invalid"));
if (invalid) {
  for (const issue of invalid.issues ?? []) console.error(issue.description ?? issue.title);
  process.exit(1);
}
NODE
  then
    printf '  %-16s INVALID (OMO parser rejected generated runtime: %s)\n' "$team OMO config" "$report"
    return 1
  fi
  printf '  %-16s VALID\n' "$team OMO config"
}

ensure_serena() {
  local tool_root="$DATA_ROOT/tools/serena" tool_bin="$DATA_ROOT/bin" serena_bin version uv_cache="$CACHE_ROOT/uv"
  if [ -n "${OPENCODE_TEAM_DEPENDENCY_ROOT:-}" ]; then
    tool_root="$DEPENDENCY_ROOT/serena"
    tool_bin="$DEPENDENCY_ROOT/bin"
    uv_cache="$DEPENDENCY_ROOT/uv-cache"
  fi
  serena_bin="$tool_bin/serena"
  mkdir -p "$tool_root" "$tool_bin" "$uv_cache"
  if [ -x "$serena_bin" ]; then
    version="$($serena_bin --version 2>/dev/null || true)"
    if serena_version_ok "$version"; then
      export SERENA_BIN="$serena_bin"
      printf '  %-18s OK (cached, %s)\n' "Serena" "$SERENA_VERSION"
      return 0
    fi
  fi
  printf '  %-18s installing %s\n' "Serena" "$SERENA_VERSION"
  UV_TOOL_DIR="$tool_root" UV_TOOL_BIN_DIR="$tool_bin" UV_CACHE_DIR="$uv_cache" \
    uv tool install --force --python "$PYTHON_BIN" "serena-agent==$SERENA_VERSION" || return 1
  [ -x "$serena_bin" ] || { printf 'Serena install did not create %s\n' "$serena_bin" >&2; return 1; }
  version="$($serena_bin --version 2>/dev/null || true)"
  serena_version_ok "$version" || { printf 'Unsupported Serena version: %s\n' "$version" >&2; return 1; }
  export SERENA_BIN="$serena_bin"
  printf '  %-18s OK (%s)\n' "Serena" "$SERENA_VERSION"
}

ensure_codex() {
  if command -v codex >/dev/null 2>&1; then
    printf '  %-18s OK (%s)\n' "Codex" "$(command -v codex)"
    return 0
  fi
  printf '  %-18s missing; attempting Homebrew cask install\n' "Codex"
  require_command brew >/dev/null || return 1
  HOMEBREW_NO_INSTALL_CLEANUP=1 brew install --cask codex || return 1
  command -v codex >/dev/null 2>&1 || { printf 'Codex install did not provide codex\n' >&2; return 1; }
  printf '  %-18s OK (%s)\n' "Codex" "$(command -v codex)"
}

doctor() {
  local failed=0
  printf 'OpenCode Team doctor\n'
  printf '  OS               %s\n' "$(uname -s)"
  printf '  architecture     %s\n' "$(uname -m)"
  if [ -d "$PACKAGE_ROOT" ] && [ -f "$VERSION_FILE" ]; then
    printf '  package root      OK (%s)\n' "$PACKAGE_ROOT"
  else
    printf '  package root      MISSING (%s)\n' "$PACKAGE_ROOT"
    failed=1
  fi
  require_command brew || failed=1
  if load_opencode; then
    printf '  %-16s OK (%s, %s)\n' "OpenCode" "$OPENCODE_VERSION" "$OPENCODE_BIN"
  else
    printf '  %-16s MISSING\n' "OpenCode"
    failed=1
  fi
  check_node || failed=1
  require_command git || failed=1
  require_command jq || failed=1
  require_command tmux || failed=1
  require_command curl || failed=1
  require_command uv || failed=1
  require_command rg || failed=1
  require_command terminal-notifier || failed=1
  setup_roots
  if managed_python_healthy; then
    OPENCODE_TEAM_PYTHON="$PYTHON_BIN"
    export PYTHON_BIN OPENCODE_TEAM_PYTHON
  fi
  ensure_generated_config_current || failed=1
  local time_machine_report
  if time_machine_report="$(time_machine_status 2>/dev/null)"; then
    printf '  %-16s %s\n' "Time Machine" "$time_machine_report"
  else
    printf '  %-16s FAILED (%s)\n' "Time Machine" "$time_machine_report"
    failed=1
  fi
  if managed_python_healthy; then
    printf '  %-16s OK (%s, %s)\n' "Managed Python" "$PYTHON_VERSION" "$PYTHON_BIN"
  else
    printf '  %-16s NOT CONFIGURED\n' "Managed Python"
    failed=1
  fi
  if [ -n "${SERENA_BIN:-}" ] && [ -x "$SERENA_BIN" ] && serena_version_ok "$($SERENA_BIN --version 2>/dev/null || true)"; then
    printf '  %-16s OK (%s)\n' "Serena" "$SERENA_VERSION"
  else
    printf '  %-16s NOT CONFIGURED\n' "Serena"
    failed=1
  fi
  if command -v codex >/dev/null 2>&1; then
    printf '  %-16s OK (OPENAI)\n' "Codex"
  else
    printf '  %-16s OPENAI UNAVAILABLE\n' "Codex"
    failed=1
  fi
  if command -v gh >/dev/null 2>&1; then
    printf '  %-16s OPTIONAL / available\n' "GitHub CLI"
  else
    printf '  %-16s OPTIONAL / missing\n' "GitHub CLI"
  fi
  for team in best best-ecc deep-audit free go openai daily; do
    if [ "$team" = best-ecc ] && [ ! -f "$DATA_ROOT/best-ecc/ecc/.opencode/plugins/ecc-hooks.ts" ]; then
      printf '  %-16s NOT READY (run opencode-team best-ecc-setup)\n' "$team profile"
      continue
    fi
    if [ -f "$CONFIG_ROOT/$team/team-runtime.conf" ] && [ -f "$CONFIG_ROOT/$team/opencode.jsonc" ]; then
      if [ "$team" = deep-audit ]; then
        validate_profile_config "$team" || failed=1
        deep_audit_doctor || true
        continue
      fi
      validate_profile_config "$team" || failed=1
    else
      printf '  %-16s NOT CONFIGURED\n' "$team profile"
      failed=1
    fi
  done
  verify_best_native || failed=1
  printf 'Maintenance\n'
  maintenance_status || failed=1
  return "$failed"
}

setup_roots() {
  if [ -n "${OPENCODE_TEAM_HOME:-}" ]; then
    mkdir -p "$OPENCODE_TEAM_HOME"
    OPENCODE_TEAM_HOME="$(cd -P "$OPENCODE_TEAM_HOME" && pwd)"
    CONFIG_ROOT="$OPENCODE_TEAM_HOME/config"
    DATA_ROOT="$OPENCODE_TEAM_HOME/data"
    STATE_ROOT="$OPENCODE_TEAM_HOME/state"
    CACHE_ROOT="$OPENCODE_TEAM_HOME/cache"
  else
    CONFIG_ROOT="$HOME/.config/opencode-team"
    DATA_ROOT="$HOME/.local/share/opencode-team"
    STATE_ROOT="$HOME/.local/state/opencode-team"
    CACHE_ROOT="$HOME/.cache/opencode-team"
  fi
  RUNTIME_ROOT="$CACHE_ROOT/runtime"
  DEPENDENCY_ROOT="${OPENCODE_TEAM_DEPENDENCY_ROOT:-$DATA_ROOT/dependencies}"
  PYTHON_INSTALL_ROOT="$DEPENDENCY_ROOT/python"
  PYTHON_BIN=""
  if [ -n "${OPENCODE_TEAM_DEPENDENCY_ROOT:-}" ]; then
    SERENA_BIN="$DEPENDENCY_ROOT/bin/serena"
  else
    SERENA_BIN="$DATA_ROOT/bin/serena"
  fi
}

remove_legacy_shared_oauth_copies() {
  local source="$HOME/.local/share/opencode/auth.json" destination team removed=0
  [ -z "${OPENCODE_AUTH_SOURCE:-${OPENCODE_TEAM_OPENCODE_AUTH_SOURCE:-}}" ] || return 0
  [ -f "$source" ] && [ ! -L "$source" ] || return 0
  for team in best best-ecc; do
    destination="$DATA_ROOT/$team/data/opencode/auth.json"
    [ -f "$destination" ] && [ ! -L "$destination" ] || continue
    cmp -s "$source" "$destination" || continue
    rm -f -- "$destination"
    removed=$((removed + 1))
  done
  if [ "$removed" -gt 0 ]; then
    printf '  %-18s removed legacy shared OAuth copies; sign in separately in BEST and BEST-ECC\n' "OAuth migration"
  fi
}

managed_python_healthy() {
  local candidate
  if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
    for candidate in "$PYTHON_INSTALL_ROOT"/*/bin/python3.13; do
      if [ -x "$candidate" ]; then
        PYTHON_BIN="$candidate"
        break
      fi
    done
  fi
  [ -x "$PYTHON_BIN" ] || return 1
  OPENCODE_TEAM_PYTHON_ROOT="$PYTHON_INSTALL_ROOT" "$PYTHON_BIN" -c 'import pathlib, plistlib, secrets, sqlite3, sys, time, uuid, xml.parsers.expat; root = pathlib.Path(__import__("os").environ["OPENCODE_TEAM_PYTHON_ROOT"]).resolve(); assert sys.version_info[:2] == (3, 13); assert pathlib.Path(sys.executable).resolve().is_relative_to(root); assert pathlib.Path(sys.prefix).resolve().is_relative_to(root); assert pathlib.Path(sys.base_prefix).resolve().is_relative_to(root); assert pathlib.Path(getattr(sys, "_base_executable", sys.executable)).resolve().is_relative_to(root)' >/dev/null 2>&1
}

ensure_python() {
  command -v uv >/dev/null 2>&1 || {
    printf 'uv is required to provision managed Python\n' >&2
    return 1
  }
  if ! managed_python_healthy; then
    rm -rf "$PYTHON_INSTALL_ROOT"
    uv python install --managed-python --no-bin --install-dir "$PYTHON_INSTALL_ROOT" "$PYTHON_VERSION" || return 1
    PYTHON_BIN=""
  fi
  managed_python_healthy || {
    printf 'Managed Python failed health checks: %s\n' "$PYTHON_BIN" >&2
    return 1
  }
  OPENCODE_TEAM_PYTHON="$PYTHON_BIN"
  export PYTHON_BIN OPENCODE_TEAM_PYTHON
  python_details="$($PYTHON_BIN -c 'import sys; print(sys.executable); print(sys.version.split()[0]); print(sys.prefix); print(sys.base_prefix); print(getattr(sys, "_base_executable", None))')" || return 1
  printf '  %-18s OK (%s, %s)\n' "Managed Python" "$(printf '%s\n' "$python_details" | sed -n '2p')" "$(printf '%s\n' "$python_details" | sed -n '1p')"
  printf '  %-18s prefix=%s base=%s executable=%s\n' "Python ownership" "$(printf '%s\n' "$python_details" | sed -n '3p')" "$(printf '%s\n' "$python_details" | sed -n '4p')" "$(printf '%s\n' "$python_details" | sed -n '5p')"
}

ensure_profile_roots() {
  local team="$1"
  mkdir -p \
    "$CONFIG_ROOT/$team/xdg-config" \
    "$CONFIG_ROOT/$team/claude-config" \
    "$DATA_ROOT/$team" \
    "$DATA_ROOT/$team/data" \
    "$DATA_ROOT/$team/playwright/output" \
    "$STATE_ROOT/$team" \
    "$CACHE_ROOT/$team" \
    "$RUNTIME_ROOT/$team"
  chmod 700 \
    "$CONFIG_ROOT/$team" \
    "$CONFIG_ROOT/$team/xdg-config" \
    "$CONFIG_ROOT/$team/claude-config" \
    "$DATA_ROOT/$team" \
    "$DATA_ROOT/$team/data" \
    "$DATA_ROOT/$team/playwright/output" \
    "$STATE_ROOT/$team" \
    "$CACHE_ROOT/$team" \
    "$RUNTIME_ROOT/$team"
}

render_deep_audit_profile() {
  ensure_profile_roots deep-audit
  mkdir -p "$CONFIG_ROOT/deep-audit/xdg-config/opencode" "$DATA_ROOT/deep-audit/reports" "$DATA_ROOT/deep-audit/plugins" "$DATA_ROOT/deep-audit/serena"
  chmod 700 "$DATA_ROOT/deep-audit/reports" "$DATA_ROOT/deep-audit/plugins" "$DATA_ROOT/deep-audit/serena"
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  SERENA_BIN="${SERENA_BIN:-$DATA_ROOT/bin/serena}"
  export SERENA_BIN
  render_template "$PACKAGE_ROOT/teams/deep-audit/team-runtime.conf.template" "$CONFIG_ROOT/deep-audit/team-runtime.conf" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/opencode.jsonc.template" "$CONFIG_ROOT/deep-audit/opencode.jsonc" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/tui.json.template" "$CONFIG_ROOT/deep-audit/xdg-config/opencode/tui.json" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/report-plugin.mjs.template" "$DATA_ROOT/deep-audit/plugins/report-plugin.mjs" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/scanner-plugin.mjs.template" "$DATA_ROOT/deep-audit/plugins/scanner-plugin.mjs" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/test-runner-plugin.mjs.template" "$DATA_ROOT/deep-audit/plugins/test-runner-plugin.mjs" || return 1
  render_template "$PACKAGE_ROOT/teams/deep-audit/serena_config.yml.template" "$DATA_ROOT/deep-audit/serena/serena_config.yml" || return 1
  chmod 600 "$CONFIG_ROOT/deep-audit/team-runtime.conf" "$CONFIG_ROOT/deep-audit/opencode.jsonc" "$CONFIG_ROOT/deep-audit/xdg-config/opencode/tui.json" "$DATA_ROOT/deep-audit/plugins/report-plugin.mjs" "$DATA_ROOT/deep-audit/plugins/scanner-plugin.mjs" "$DATA_ROOT/deep-audit/plugins/test-runner-plugin.mjs" "$DATA_ROOT/deep-audit/serena/serena_config.yml"
}

maintenance_tasks() {
  printf '%s\n' best-tool-output-gc best-retention openai-retention runtime-gc playwright-gc host-storage-gc version-check
}

maintenance_label() {
  case "$1" in
    best-tool-output-gc) printf '%s\n' 'it.danilodantoni.opencode-team.best-tool-output-gc' ;;
    best-retention) printf '%s\n' 'it.danilodantoni.opencode-team.best-retention' ;;
    openai-retention) printf '%s\n' 'it.danilodantoni.opencode-team.openai-retention' ;;
    runtime-gc) printf '%s\n' 'it.danilodantoni.opencode-team.runtime-gc' ;;
    playwright-gc) printf '%s\n' 'it.danilodantoni.opencode-team.playwright-gc' ;;
    host-storage-gc) printf '%s\n' 'it.danilodantoni.opencode-team.host-storage-gc' ;;
    version-check) printf '%s\n' 'it.danilodantoni.opencode-team.version-check' ;;
    *) return 1 ;;
  esac
}

legacy_maintenance_plist() {
  printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$1"
}

legacy_label_for_task() {
  case "$1" in
    best-tool-output-gc) printf '%s\n' com.thomasd.opencode-best-tool-output-gc ;;
    best-retention) printf '%s\n' com.thomasd.opencode-best-retention ;;
    openai-retention) printf '%s\n' com.thomasd.opencode-retention ;;
    *) return 1 ;;
  esac
}

legacy_task_detected() {
  [ "${OPENCODE_TEAM_LEGACY_MAINTENANCE:-}" = 1 ] && return 0
  [ -n "${OPENCODE_TEAM_HOME:-}" ] && return 1
  local label="$1" plist
  plist="$(legacy_maintenance_plist "$label")"
  [ -f "$plist" ] && return 0
  launchctl print "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1
}

legacy_maintenance_detected() {
  local label
  for label in com.thomasd.opencode-best-tool-output-gc com.thomasd.opencode-best-retention com.thomasd.opencode-retention; do
    legacy_task_detected "$label" && return 0
  done
  return 1
}

legacy_task_package_owned() {
  local task="$1" label plist executable
  case "$task" in
    best-tool-output-gc)
      label=com.thomasd.opencode-best-tool-output-gc
      plist="$(legacy_maintenance_plist "$label")"
      [ -f "$plist" ] || return 1
      executable="$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null || true)"
      [ "$executable" = "$HOME/.opencode-team-staging/unified-core-v1/teams/best/tool-output-gc.mjs" ] && [ -f "$executable" ]
      ;;
    best-retention|openai-retention)
      label="$(legacy_label_for_task "$task")"
      plist="$(legacy_maintenance_plist "$label")"
      [ -f "$plist" ] || return 1
      executable="$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null || true)"
      [ "$executable" = "$HOME/.local/bin/opencode-cleanup" ] && [ -f "$executable" ] || return 1
  "$PYTHON_BIN" - "$plist" "$task" "$executable" <<'PY'
import plistlib
import sys

path, task, executable = sys.argv[1:]
with open(path, "rb") as stream:
    plist = plistlib.load(stream)
expected = [
    executable,
    "--retention-only",
    "--live-retention",
    "--team",
    "best" if task == "best-retention" else "openai",
    "--max-families",
    "1" if task == "best-retention" else "3",
    "--max-session-deletes",
    "3" if task == "best-retention" else "10",
]
actual = list(plist.get("ProgramArguments", []))
sys.exit(0 if actual == expected and plist.get("Label") in {"com.thomasd.opencode-best-retention", "com.thomasd.opencode-retention"} else 1)
PY
      ;;
    *)
      return 1
      ;;
  esac
}

migrate_legacy_task() {
  local task="$1" label plist
  case "$task" in
    best-tool-output-gc) label=com.thomasd.opencode-best-tool-output-gc ;;
    best-retention) label=com.thomasd.opencode-best-retention ;;
    openai-retention) label=com.thomasd.opencode-retention ;;
    *) return 1 ;;
  esac
  plist="$(legacy_maintenance_plist "$label")"
  launchctl bootout "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1 || true
  rm -f "$plist"
  printf '  %-18s migrated exact legacy job (%s)\n' "$task" "$label"
}

legacy_cleanup_package_owned() {
  local label=com.thomasd.opencode-cleanup plist executable
  plist="$(legacy_maintenance_plist "$label")"
  [ -f "$plist" ] || return 1
  executable="$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null || true)"
  [ "$executable" = "$HOME/.local/bin/opencode-cleanup" ] && [ -f "$executable" ] || return 1
  "$PYTHON_BIN" - "$plist" "$executable" <<'PY'
import plistlib
import sys

path, executable = sys.argv[1:]
with open(path, "rb") as stream:
    plist = plistlib.load(stream)
expected = [executable]
actual = list(plist.get("ProgramArguments", []))
sys.exit(0 if actual == expected and plist.get("Label") == "com.thomasd.opencode-cleanup" else 1)
PY
}

migrate_legacy_cleanup() {
  local label=com.thomasd.opencode-cleanup plist
  if ! legacy_cleanup_package_owned; then return 0; fi
  plist="$(legacy_maintenance_plist "$label")"
  launchctl bootout "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1 || true
  rm -f "$plist"
  printf '  legacy cleanup migrated exact job (%s)\n' "$label"
}

maintenance_status() {
  local task marker status failed=0
  for task in $(maintenance_tasks); do
    marker="$STATE_ROOT/maintenance/status/$task"
    if [ -f "$marker" ]; then
      status="$(< "$marker")"
    elif legacy_maintenance_detected; then
      status=DEFERRED
    else
      status=MISSING
    fi
    if [ "$status" = INSTALLED ] && ! maintenance_task_healthy "$task"; then
      status=BROKEN
      failed=1
    fi
    case "$task" in
      best-tool-output-gc) printf '  BEST tool-output GC  %s\n' "$status" ;;
      best-retention) printf '  BEST retention       %s\n' "$status" ;;
      openai-retention) printf '  OPENAI retention     %s\n' "$status" ;;
      runtime-gc) printf '  Runtime GC           %s\n' "$status" ;;
      playwright-gc) printf '  Playwright GC        %s\n' "$status" ;;
      host-storage-gc) printf '  Host storage GC      %s\n' "$status" ;;
      version-check) printf '  Version check        %s\n' "$status" ;;
    esac
  done
  return "$failed"
}

maintenance_task_healthy() {
  local task="$1" label plist agent_dir
  label="$(maintenance_label "$task")" || return 1
  if [ -n "${OPENCODE_TEAM_HOME:-}" ]; then
    agent_dir="$STATE_ROOT/maintenance/launchagents"
  else
    agent_dir="$HOME/Library/LaunchAgents"
  fi
  plist="$agent_dir/$label.plist"
  [ -f "$plist" ] || return 1
  plutil -lint "$plist" >/dev/null 2>&1 || return 1
  if [ -z "${OPENCODE_TEAM_HOME:-}" ]; then
    launchctl print "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1 || return 1
  fi
}

write_maintenance_plist() {
  local task="$1" destination="$2" label executable log_path temporary
  label="$(maintenance_label "$task")"
  executable="${OPENCODE_TEAM_EXECUTABLE:-$(command -v opencode-team || printf '%s/bin/opencode-team' "$PACKAGE_ROOT")}"
  log_path="$STATE_ROOT/maintenance/logs/$task.launchd.log"
  temporary="${destination}.tmp.$$"
  "$PYTHON_BIN" - "$temporary" "$label" "$executable" "$task" "$log_path" "${OPENCODE_TEAM_HOME:-}" <<'PY'
import os
import pathlib
import plistlib
import sys

destination, label, executable, task, log_path, team_home = sys.argv[1:]
environment = {
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "OPENCODE_TEAM_PYTHON": os.environ["OPENCODE_TEAM_PYTHON"],
}
if team_home:
    environment["OPENCODE_TEAM_HOME"] = team_home
hour, minute = {
    "best-tool-output-gc": (4, 45),
    "best-retention": (5, 0),
    "openai-retention": (4, 15),
     "runtime-gc": (5, 30),
    "playwright-gc": (0, 0),
    "host-storage-gc": (0, 30),
    "version-check": (0, 0),
}[task]
plist = {
    "Label": label,
    "ProgramArguments": [executable, "maintenance", task],
    "EnvironmentVariables": environment,
    "StandardOutPath": log_path,
    "StandardErrorPath": log_path.replace(".log", ".err"),
    "ProcessType": "Background",
}
if task in {"playwright-gc", "host-storage-gc"}:
    plist["StartInterval"] = 4 * 60 * 60
else:
    plist["StartCalendarInterval"] = {"Hour": hour, "Minute": minute}
if task == "version-check":
    plist["StartInterval"] = 12 * 60 * 60
    plist["RunAtLoad"] = True
pathlib.Path(destination).parent.mkdir(parents=True, exist_ok=True)
with pathlib.Path(destination).open("wb") as stream:
    plistlib.dump(plist, stream, sort_keys=False)
PY
  if [ -f "$destination" ] && cmp -s "$temporary" "$destination"; then
    rm -f "$temporary"
  else
    mv "$temporary" "$destination" || {
      rm -f "$temporary"
      return 1
    }
  fi
  plutil -lint "$destination" >/dev/null 2>&1 || return 1
}

install_maintenance() {
  local task plist label agent_dir status_marker legacy_label
  mkdir -p "$STATE_ROOT/maintenance/status" "$STATE_ROOT/maintenance/logs"
  migrate_legacy_cleanup
  if [ -n "${OPENCODE_TEAM_HOME:-}" ]; then
    agent_dir="$STATE_ROOT/maintenance/launchagents"
  else
    agent_dir="$HOME/Library/LaunchAgents"
  fi
  for task in $(maintenance_tasks); do
    legacy_label="$(legacy_label_for_task "$task" 2>/dev/null || true)"
    if [ -n "$legacy_label" ] && legacy_task_detected "$legacy_label"; then
      if legacy_task_package_owned "$task"; then
        migrate_legacy_task "$task"
      else
        printf '  %-18s deferred: ownership is not package-conclusive\n' "$task"
        printf '%s\n' DEFERRED > "$STATE_ROOT/maintenance/status/$task"
        continue
      fi
    fi
    label="$(maintenance_label "$task")"
    plist="$agent_dir/$label.plist"
    write_maintenance_plist "$task" "$plist" || return 1
    if [ -n "${OPENCODE_TEAM_HOME:-}" ]; then
      status=INSTALLED
    else
      if launchctl print "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1; then
        status=INSTALLED
      else
        launchctl bootstrap "gui/${UID:-$(id -u)}" "$plist" || return 1
        launchctl enable "gui/${UID:-$(id -u)}/$label" || return 1
        launchctl print "gui/${UID:-$(id -u)}/$label" >/dev/null 2>&1 || return 1
        status=INSTALLED
      fi
    fi
    maintenance_task_healthy "$task" || return 1
    printf '%s\n' "$status" > "$STATE_ROOT/maintenance/status/$task" || return 1
    printf '  %-18s OK (%s)\n' "$task" "$status"
  done
}

maintenance_command() {
  setup_roots
  if [ "${1:-}" != version-check ]; then
    if ! ensure_opencode_loaded; then
      printf 'OpenCode is required for setup\n' >&2
      return 1
    fi
  fi
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  if [ "${1:-}" = status ]; then
    [ "$#" -eq 1 ] || { usage >&2; return 2; }
    maintenance_status
    return 0
  fi
  [ "$#" -eq 1 ] || { usage >&2; return 2; }
  case "$1" in
    best-tool-output-gc|best-retention|openai-retention|runtime-gc|playwright-gc|host-storage-gc|version-check)
      local team=best
      [ "$1" = openai-retention ] && team=openai
      if [ "$1" != runtime-gc ] && [ "$1" != version-check ] && [ ! -f "$CONFIG_ROOT/$team/team-runtime.conf" ]; then
        printf 'Maintenance is not configured: %s\n' "$1" >&2
        return 1
      fi
      exec "$PACKAGE_ROOT/shared/maintenance/run-maintenance.sh" "$1"
      ;;
    *)
      printf 'Unknown maintenance task: %s\n' "$1" >&2
      return 2
      ;;
  esac
}

install_dependencies() {
  local team="$1" dependency_team="$1"
  [ "$team" = daily ] && dependency_team=openai
  [ "$team" = free ] && dependency_team=best
  [ "$team" = best-ecc ] && dependency_team=best
  local dependency_root="$DEPENDENCY_ROOT/$dependency_team"
  local package_file="$PACKAGE_ROOT/teams/$dependency_team/package.json"
  local lock_file="$PACKAGE_ROOT/teams/$dependency_team/package-lock.json"
  local marker="$dependency_root/.installed-lock-sha256"
  local lock_hash
  lock_hash="$(shasum -a 256 "$lock_file" | cut -d' ' -f1)"
  if [ -f "$marker" ] && [ "$(< "$marker")" = "$lock_hash" ] && [ -d "$dependency_root/node_modules/oh-my-openagent" ]; then
    printf '  %-18s OK (cached)\n' "$team dependencies"
    return 0
  fi
  mkdir -p "$dependency_root"
  cp "$package_file" "$dependency_root/package.json"
  cp "$lock_file" "$dependency_root/package-lock.json"
  npm ci --ignore-scripts --no-audit --no-fund --prefix "$dependency_root"
  printf '%s\n' "$lock_hash" > "$marker"
  chmod 600 "$marker" "$dependency_root/package.json" "$dependency_root/package-lock.json"
  printf '  %-18s OK\n' "$team dependencies"
}

verify_best_omo() {
  local target="$DEPENDENCY_ROOT/best/node_modules/oh-my-openagent/dist/index.js"
  [ -f "$target" ] || { printf 'BEST OMO package missing\n' >&2; return 1; }
  "$PACKAGE_ROOT/teams/best/patch-omo-hook-timeout.sh" "$target"
  "$PYTHON_BIN" "$PACKAGE_ROOT/teams/best/patch-omo-core.py" "$target"
  "$PACKAGE_ROOT/teams/best/patch-omo-isolation.sh" "$target"
  "$PACKAGE_ROOT/teams/best/verify-omo.sh" "$target"
  printf '  %-18s OK (patched and verified)\n' "best OMO"
}

verify_best_native() {
  local entrypoint="$DEPENDENCY_ROOT/best/node_modules/omo-ai/bin/omo.js" version config_file native_runtime
  config_file="$DATA_ROOT/best/.omo/omo.jsonc"
  [ -f "$entrypoint" ] || { printf 'BEST Native OMO package missing\n' >&2; return 1; }
  native_runtime="$(resolve_native_runtime)" || return 1
  version="$("$native_runtime" "$entrypoint" --version 2>/dev/null)"
  [[ "$version" == "omo 5.1.27 (engine: senpi "* ]] || {
    printf 'BEST Native OMO version mismatch: %s\n' "$version" >&2
    return 1
  }
  [ -f "$config_file" ] || { printf 'BEST Native OMO config missing: %s\n' "$config_file" >&2; return 1; }
  node -e 'const c=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")); if (!c.profiles?.["best-native"]?.["[native]"]?.memory?.enabled) process.exit(1)' "$config_file" || {
    printf 'BEST Native OMO profile or persistent-memory config is invalid\n' >&2
    return 1
  }
  printf '  %-18s OK (5.1.27, isolated native memory profile)\n' "best Native OMO"
}

deep_audit_model_check() {
  local openai_models resolved_config
  ensure_opencode_loaded || {
    printf '  %-18s UNAVAILABLE (supported Homebrew OpenCode is missing)\n' "Deep Audit models" >&2
    return 1
  }
  openai_models="$(XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" \
    XDG_DATA_HOME="$DATA_ROOT/deep-audit/data" \
    XDG_CACHE_HOME="$CACHE_ROOT/deep-audit" \
    OPENCODE_CONFIG="$CONFIG_ROOT/deep-audit/opencode.jsonc" \
    OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    "$OPENCODE_BIN" models openai 2>&1)" || {
      printf '  %-18s UNAVAILABLE (OpenCode cannot enumerate OpenAI models): %s\n' "Deep Audit models" "${openai_models:0:1000}" >&2
      return 1
    }
  for model in openai/gpt-6-astra openai/gpt-6.1-sol; do
    printf '%s\n' "$openai_models" | grep -Fxq "$model" || {
      printf '  %-18s MISSING %s (no model fallback permitted)\n' "Deep Audit model" "$model" >&2
      return 1
    }
  done
  resolved_config="$(XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" \
    XDG_DATA_HOME="$DATA_ROOT/deep-audit/data" \
    XDG_CACHE_HOME="$CACHE_ROOT/deep-audit" \
    OPENCODE_CONFIG="$CONFIG_ROOT/deep-audit/opencode.jsonc" \
    OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 \
    "$OPENCODE_BIN" debug config 2>/dev/null)" || {
      printf 'Deep Audit resolved OpenCode config could not be inspected\n' >&2
      return 1
    }
  printf '%s\n' "$resolved_config" | jq -e '
    .model == "openai/gpt-6-astra" and
    .agent["audit-orchestrator"].model == "openai/gpt-6-astra" and
    .agent["audit-orchestrator"].variant == "xhigh" and
    .agent["audit-reviewer"].model == "openai/gpt-6-astra" and
    .agent["audit-reviewer"].variant == "max" and
    .agent["audit-performance"].model == "openai/gpt-6.1-sol" and
    .agent["audit-inventory"].model == "openai/gpt-6-luna"
  ' >/dev/null || {
    printf 'Deep Audit resolved model/variant config does not match the pinned policy\n' >&2
    return 1
  }
  printf '  %-18s OK (GPT-6 Astra + GPT-6.1 Sol; model catalog only)\n' "Deep Audit models"
}

verify_deep_audit_ecc() {
  local source="$DATA_ROOT/deep-audit/ecc" expected actual skill
  expected="$(<"$PACKAGE_ROOT/teams/best-ecc/ecc.lock")"
  [ -d "$source/.git" ] || { printf 'Deep Audit ECC assets missing; run opencode-team deep-audit-setup\n' >&2; return 1; }
  actual="$(git -C "$source" rev-parse HEAD 2>/dev/null || true)"
  [ "$actual" = "$expected" ] || { printf 'Deep Audit ECC pin mismatch (expected %s, got %s)\n' "$expected" "${actual:-unknown}" >&2; return 1; }
  for skill in coding-standards backend-patterns security-review verification-loop production-audit django-patterns django-security django-verification django-tdd python-patterns python-testing mysql-patterns database-migrations api-design e2e-testing agent-architecture-audit workspace-surface-audit mcp-dependency-review; do
    [ -f "$source/skills/$skill/SKILL.md" ] || { printf 'Deep Audit ECC skill missing: %s\n' "$skill" >&2; return 1; }
  done
  printf '  %-18s OK (18 pinned skills, no hooks)\n' "Deep Audit ECC"
}

verify_deep_audit_sandbox() {
  local root target profile report_probe
  DEEP_AUDIT_DEPENDENCY_ROOT="$DEPENDENCY_ROOT"
  DEEP_AUDIT_SERENA_BIN="$SERENA_BIN"
  export DEEP_AUDIT_DEPENDENCY_ROOT
  export DEEP_AUDIT_SERENA_BIN
  [ -x /usr/bin/sandbox-exec ] || { printf 'sandbox-exec is unavailable\n' >&2; return 1; }
  root="$(mktemp -d "${TMPDIR:-/tmp}/deep-audit-sandbox-check.XXXXXX")" || return 1
  root="$(cd -P "$root" && pwd)"
  target="$root/target"
  profile="$root/readonly-project.sb"
  mkdir -m 700 "$target"
  if SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$target/must-not-exist" >/dev/null 2>&1; then
    rm -rf "$root"
    printf 'sandbox-exec allowed a write inside the audit target\n' >&2
    return 1
  fi
  [ ! -e "$target/must-not-exist" ] || { rm -rf "$root"; printf 'Read-only sandbox target was modified\n' >&2; return 1; }
  report_probe="$root/report-probe"
  if ! SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$report_probe" >/dev/null 2>&1; then
    rm -rf "$root"
    printf 'sandbox-exec blocked writes outside the audit target unexpectedly\n' >&2
    return 1
  fi
  [ -f "$report_probe" ] || { rm -rf "$root"; printf 'Sandbox report-write probe missing\n' >&2; return 1; }
  local profile_probe="$DATA_ROOT/deep-audit/reports/.sandbox-write-probe.$$" auth_probe="$DATA_ROOT/deep-audit/data/opencode/.sandbox-auth-probe.$$" config_probe="$CONFIG_ROOT/deep-audit/.sandbox-config-probe.$$" host_probe="$HOME/.deep-audit-unapproved-write-probe.$$" other_profile_probe sibling_root sibling_created=0 fake_home="$root/fake-home" secret_file
  mkdir -p "$fake_home/.ssh" "$fake_home/.docker" "$fake_home/.config/opencode" "$fake_home/.config/gh" "$fake_home/.local/share/opencode" "$DATA_ROOT/deep-audit/data/opencode"
  printf '%s\n' 'sandbox fixture secret' >"$fake_home/.ssh/id_ed25519"
  printf '%s\n' '{"auths":{"registry.example.invalid":{"auth":"fixture"}}}' >"$fake_home/.docker/config.json"
  printf '%s\n' 'sandbox fixture OAuth' >"$fake_home/.config/opencode/auth.json"
  printf '%s\n' 'sandbox fixture GitHub token' >"$fake_home/.config/gh/hosts.yml"
  printf '%s\n' 'sandbox shared OAuth' >"$fake_home/.local/share/opencode/auth.json"
  if ! SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$profile_probe" >/dev/null 2>&1; then
    rm -rf "$root"
    printf 'Sandbox blocked writes to the profile-owned report directory\n' >&2
    return 1
  fi
  rm -f "$profile_probe"
  if ! SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$auth_probe" >/dev/null 2>&1; then
    rm -rf "$root"
    printf 'Sandbox blocked profile-local OAuth persistence\n' >&2
    return 1
  fi
  rm -f "$auth_probe"
  if ! SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$config_probe" >/dev/null 2>&1; then
    rm -rf "$root"
    printf 'Sandbox blocked profile-local OpenCode configuration writes\n' >&2
    return 1
  fi
  rm -f "$config_probe"
  for secret_file in "$fake_home/.ssh/id_ed25519" "$fake_home/.docker/config.json" "$fake_home/.config/opencode/auth.json" "$fake_home/.config/gh/hosts.yml" "$fake_home/.local/share/opencode/auth.json"; do
    if ! HOME="$fake_home" SANDBOX="$DATA_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/bin/cat DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$secret_file" >/dev/null 2>&1; then
      continue
    fi
    rm -rf "$root"
    printf 'Sandbox allowed reads from a sensitive home path: %s\n' "$secret_file" >&2
    return 1
  done
  sibling_root="$DATA_ROOT/best"
  if [ ! -d "$sibling_root" ]; then mkdir -m 700 "$sibling_root" || { rm -rf "$root"; return 1; }; sibling_created=1; fi
  other_profile_probe="$sibling_root/.deep-audit-read-probe.$$"
  printf '%s\n' 'other-profile probe' >"$other_profile_probe"
  if HOME="$fake_home" SANDBOX="$DATA_ROOT/deep-audit" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/bin/cat DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$other_profile_probe" >/dev/null 2>&1; then
    rm -f "$other_profile_probe"
    [ "$sibling_created" -eq 0 ] || rmdir "$sibling_root" 2>/dev/null || true
    rm -rf "$root"
    printf 'Sandbox allowed reads from sibling OpenCode Team profile data\n' >&2
    return 1
  fi
  rm -f "$other_profile_probe"
  [ "$sibling_created" -eq 0 ] || rmdir "$sibling_root" 2>/dev/null || true
  if SANDBOX="$DATA_ROOT/deep-audit" XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" RUNTIME_ROOT="$CACHE_ROOT/runtime/deep-audit" DEEP_AUDIT_TARGET_ROOT="$target" DEEP_AUDIT_REAL_OPENCODE_BIN=/usr/bin/touch DEEP_AUDIT_SANDBOX_PROFILE="$profile" OPENCODE_TEAM_PYTHON="$PYTHON_BIN" "$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" "$host_probe" >/dev/null 2>&1; then
    rm -f "$host_probe"
    rm -rf "$root"
    printf 'Sandbox allowed an unapproved write inside the host home directory\n' >&2
    return 1
  fi
  [ ! -e "$host_probe" ] || { rm -f "$host_probe"; rm -rf "$root"; printf 'Sandbox host-write probe left a file behind\n' >&2; return 1; }
  rm -rf "$root"
  printf '  %-18s OK (target writes denied; profile reports allowed; sensitive host paths denied)\n' "Read-only sandbox"
}

deep_audit_test_runner_ready() {
  local images_file="$DEPENDENCY_ROOT/deep-audit/test-runners/images.json" marker="$DATA_ROOT/deep-audit/test-runner-validation.json" docker_bin
  docker_bin="$(command -v docker 2>/dev/null || true)"
  [ -n "$docker_bin" ] && [ -f "$images_file" ] && [ -f "$marker" ] || return 1
  node "$PACKAGE_ROOT/teams/deep-audit/bin/test-runner-health.mjs" \
    "$PACKAGE_ROOT" "$DATA_ROOT/deep-audit/plugins/test-runner-plugin.mjs" \
    "$images_file" "$marker" "$docker_bin"
}

deep_audit_doctor() {
  local failed=0 auth_file="$DATA_ROOT/deep-audit/data/opencode/auth.json" scanner_root="$DEPENDENCY_ROOT/deep-audit/scanners" binary resolved_config plugin
  if managed_python_healthy; then
    export PYTHON_BIN OPENCODE_TEAM_PYTHON
  else
    printf '  %-18s MISSING\n' "Deep Audit Python" >&2
    return 1
  fi
  SERENA_BIN="${SERENA_BIN:-$DATA_ROOT/bin/serena}"
  export SERENA_BIN
  if [ -f "$DATA_ROOT/deep-audit/serena/npmrc" ]; then
    npm_config_userconfig="$DATA_ROOT/deep-audit/serena/npmrc"
  else
    npm_config_userconfig=/dev/null
  fi
  export npm_config_userconfig
  if [ ! -f "$CONFIG_ROOT/deep-audit/team-runtime.conf" ] || [ ! -f "$CONFIG_ROOT/deep-audit/opencode.jsonc" ]; then
    printf '  %-18s NOT CONFIGURED (run opencode-team deep-audit-setup)\n' "deep-audit profile"
    return 1
  fi
  validate_profile_config deep-audit || failed=1
  verify_deep_audit_sandbox || failed=1
  if [ -x "$SERENA_BIN" ] && serena_version_ok "$($SERENA_BIN --version 2>/dev/null || true)"; then
    printf '  %-18s OK (%s)\n' "Deep Audit Serena" "$SERENA_VERSION"
  else
    printf '  %-18s MISSING\n' "Deep Audit Serena" >&2
    failed=1
  fi
  verify_deep_audit_ecc || failed=1
  if [ -f "$DATA_ROOT/deep-audit/plugins/report-plugin.mjs" ]; then
    printf '  %-18s OK (profile-owned report writer)\n' "Deep Audit reports"
  else
    printf '  %-18s MISSING (run deep-audit-setup)\n' "Deep Audit reports" >&2
    failed=1
  fi
  deep_audit_model_check || failed=1
  # Files on disk prove installation only. Inspect the runtime-resolved profile for
  # plugin registration and tool exposure; never infer readiness from filenames.
  resolved_config="$(XDG_CONFIG_HOME="$CONFIG_ROOT/deep-audit/xdg-config" \
    XDG_DATA_HOME="$DATA_ROOT/deep-audit/data" XDG_CACHE_HOME="$CACHE_ROOT/deep-audit" \
    OPENCODE_CONFIG="$CONFIG_ROOT/deep-audit/opencode.jsonc" OPENCODE_CONFIG_DIR="$CONFIG_ROOT/deep-audit" \
    OPENCODE_DISABLE_PROJECT_CONFIG=1 "$OPENCODE_BIN" debug config 2>/dev/null)" || resolved_config=""
  if [ -z "$resolved_config" ]; then
    printf '  %-18s UNPROVEN (runtime diagnostics unavailable; failing closed)\n' "Deep Audit tools" >&2
    failed=1
  else
    for plugin in report-plugin.mjs scanner-plugin.mjs test-runner-plugin.mjs; do
      if [ -f "$DATA_ROOT/deep-audit/plugins/$plugin" ] \
        && printf '%s\n' "$resolved_config" | jq -e --arg plugin "$plugin" 'any(.plugin[]?; (tostring | contains($plugin)))' >/dev/null 2>&1; then
        printf '  %-18s INSTALLED + CONFIGURED\n' "$plugin"
      else
        printf '  %-18s UNAVAILABLE (not installed and referenced by resolved config)\n' "$plugin" >&2
        failed=1
      fi
    done
    if OPENCODE_TEAM_DEEP_AUDIT_CONFIG="$CONFIG_ROOT/deep-audit/opencode.jsonc" \
      OPENCODE_TEAM_DEEP_AUDIT_LAUNCHER="$PACKAGE_ROOT/teams/deep-audit/bin/read-only-opencode.sh" \
      OPENCODE_TEAM_DEEP_AUDIT_SANDBOX="$DATA_ROOT/deep-audit" \
      OPENCODE_TEAM_DEEP_AUDIT_CONFIG_DIR="$CONFIG_ROOT/deep-audit" \
      OPENCODE_TEAM_DEEP_AUDIT_XDG_CONFIG="$CONFIG_ROOT/deep-audit/xdg-config" \
      OPENCODE_TEAM_DEEP_AUDIT_DEPENDENCY_ROOT="$DEPENDENCY_ROOT" \
      OPENCODE_TEAM_DEEP_AUDIT_SERENA_BIN="$SERENA_BIN" \
      OPENCODE_TEAM_DEEP_AUDIT_REAL_BINARY="$OPENCODE_BIN" \
      OPENCODE_TEAM_DEEP_AUDIT_PYTHON="$PYTHON_BIN" \
      OPENCODE_TEAM_DEEP_AUDIT_TEST_RUNNER_IMAGES="$DEPENDENCY_ROOT/deep-audit/test-runners/images.json" \
      OPENCODE_TEAM_DEEP_AUDIT_DOCKER_BIN="$(command -v docker 2>/dev/null || true)" \
      node --test "$PACKAGE_ROOT/tests/deep-audit-plugin-registration.test.mjs"; then
      printf '  %-18s VERIFIED (plugin tools invoked via audit-orchestrator; Serena MCP connected/read-only call executed; no model request)\n' "Runtime tool state"
      printf '  %-18s CONFIGURED (model-mediated agent use is verified only during a real audit)\n' "Serena agent binding"
    else
      printf '  %-18s BLOCKED (real OpenCode tool/MCP preflight failed)\n' "Runtime tool state" >&2
      failed=1
    fi
  fi
  if [ -f "$auth_file" ]; then
    printf '  %-18s OK (profile-local OAuth state)\n' "Deep Audit auth"
  else
    printf '  %-18s REQUIRED; launch profile and run /connect openai\n' "Deep Audit auth" >&2
    failed=1
  fi
  for scanner in jscpd ast-grep semgrep gitleaks osv-scanner ruff vulture knip bandit pip-audit sqlfluff pytest; do
    case "$scanner" in
      jscpd) binary="$scanner_root/node/node_modules/.bin/jscpd" ;;
      ast-grep) binary="$scanner_root/node/node_modules/.bin/ast-grep" ;;
      knip) binary="$scanner_root/node/node_modules/.bin/knip" ;;
      gitleaks|osv-scanner) binary="$scanner_root/bin/$scanner" ;;
      *) binary="$scanner_root/python/bin/$scanner" ;;
    esac
    if [ -x "$binary" ]; then
      printf '  %-18s AVAILABLE (%s)\n' "$scanner" "$binary"
    else
      printf '  %-18s UNAVAILABLE (profile-local scanner missing)\n' "$scanner"
      failed=1
    fi
  done
  if deep_audit_test_runner_ready \
    && [ -f "$DATA_ROOT/deep-audit/plugins/test-runner-plugin.mjs" ]; then
    printf '  %-18s OK (sandbox fixture E2E and pinned images verified)\n' "Isolated test runner"
  else
    printf '  %-18s BLOCKED (local Docker test images/plugin unavailable; no host execution)\n' "Isolated test runner" >&2
    failed=1
  fi
  if [ -f "$DATA_ROOT/deep-audit/plugins/scanner-plugin.mjs" ] \
    && grep -Fq 'Deep Audit concurrency guard:' "$DATA_ROOT/deep-audit/plugins/scanner-plugin.mjs" \
    && grep -Fq 'output.args.run_in_background = false' "$DATA_ROOT/deep-audit/plugins/scanner-plugin.mjs"; then
    printf '  %-18s OK (single foreground task; hard semaphore)\n' "Task concurrency cap"
  else
    printf '  %-18s NOT ENFORCED\n' "Task concurrency cap" >&2
    failed=1
  fi
  if [ "$failed" -eq 0 ]; then
    printf '  %-18s READY FOR AUTHENTICATED AUDIT\n' "deep-audit"
  else
    printf '  %-18s NOT READY\n' "deep-audit" >&2
  fi
  return "$failed"
}

setup_deep_audit_profile() {
  setup_roots
  load_opencode || { printf 'A supported OpenCode installation is required\n' >&2; return 1; }
  ensure_profile_roots deep-audit
  if ! managed_python_healthy; then ensure_python || return 1; fi
  export PYTHON_BIN OPENCODE_TEAM_PYTHON PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  SERENA_BIN="${SERENA_BIN:-$DATA_ROOT/bin/serena}"
  mkdir -p "$DATA_ROOT/deep-audit/serena"
  if [ ! -e "$DATA_ROOT/deep-audit/serena/npmrc" ]; then (umask 077; : >"$DATA_ROOT/deep-audit/serena/npmrc"); fi
  npm_config_userconfig="$DATA_ROOT/deep-audit/serena/npmrc"
  export npm_config_userconfig
  if [ ! -x "$SERENA_BIN" ]; then ensure_serena || return 1; fi
  export SERENA_BIN
  bash "$PACKAGE_ROOT/teams/deep-audit/setup-ecc.sh" "$DATA_ROOT/deep-audit/ecc" || return 1
  bash "$PACKAGE_ROOT/teams/deep-audit/setup-scanners.sh" || return 1
  if ! bash "$PACKAGE_ROOT/teams/deep-audit/setup-test-runners.sh"; then
    printf '%s\n' 'Deep Audit isolated test runners are BLOCKED; no project code will execute outside verified containers.' >&2
  fi
  render_deep_audit_profile || return 1
  deep_audit_model_check || return 1
  rm -f "$DATA_ROOT/deep-audit/test-runner-validation.json"
  if [ -f "$DEPENDENCY_ROOT/deep-audit/test-runners/images.json" ] \
    && OPENCODE_TEAM_DEEP_AUDIT_TEST_PLUGIN="$DATA_ROOT/deep-audit/plugins/test-runner-plugin.mjs" \
      OPENCODE_TEAM_DEEP_AUDIT_TEST_RUNNER_IMAGES="$DEPENDENCY_ROOT/deep-audit/test-runners/images.json" \
      OPENCODE_TEAM_DEEP_AUDIT_TEST_DOCKER_BIN="$(command -v docker 2>/dev/null || true)" \
      OPENCODE_TEAM_DEEP_AUDIT_TEST_RUNNER_MARKER="$DATA_ROOT/deep-audit/test-runner-validation.json" \
      DEEP_AUDIT_SCANNER_ROOT="$DEPENDENCY_ROOT/deep-audit/scanners" \
      node --test "$PACKAGE_ROOT/tests/deep-audit-test-runner.e2e.mjs"; then
    if [ ! -f "$DATA_ROOT/deep-audit/test-runner-validation.json" ]; then
      printf '%s\n' 'Deep Audit test-runner E2E validation did not produce its integrity marker; profile remains NOT READY.' >&2
    fi
  else
    printf '%s\n' 'Deep Audit test-runner fixture E2E validation is BLOCKED; tests remain disabled and profile remains NOT READY.' >&2
  fi
  printf 'Deep Audit configured. Login separately inside this isolated profile with /connect openai.\n'
}

start_deep_audit() {
  local target="$PWD" target_set=0 resume=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --resume|-s)
        [ "$#" -ge 2 ] || { printf '%s\n' '--resume requires a session ID' >&2; return 2; }
        resume="$2"
        shift 2
        ;;
      --*)
        printf 'Unknown deep-audit option: %s\n' "$1" >&2
        return 2
        ;;
      *)
        [ "$target_set" -eq 0 ] || { printf '%s\n' 'Only one target project directory may be supplied' >&2; return 2; }
        target="$1"
        target_set=1
        shift
        ;;
    esac
  done
  [ -d "$target" ] || { printf 'Deep Audit target is not a directory: %s\n' "$target" >&2; return 2; }
  target="$(cd -P -- "$target" 2>/dev/null && pwd -P)" || { printf 'Deep Audit target cannot be resolved: %s\n' "$target" >&2; return 2; }
  case "$target" in
    /|/System|/System/*|/Library|/Library/*|/Users|/Users/*/Library|/Users/*/Library/*)
      printf 'Refusing system or private macOS paths as audit targets: %s\n' "$target" >&2
      return 2
      ;;
  esac
  setup_roots
  managed_python_healthy || { printf 'Managed Python is required; run opencode-team setup\n' >&2; return 1; }
  export PYTHON_BIN OPENCODE_TEAM_PYTHON
  SERENA_BIN="${SERENA_BIN:-$DATA_ROOT/bin/serena}"
  export SERENA_BIN
  [ -f "$CONFIG_ROOT/deep-audit/team-runtime.conf" ] || { printf '%s\n' 'Deep Audit is not configured; run opencode-team deep-audit-setup' >&2; return 1; }
  deep_audit_model_check || return 1
  verify_deep_audit_ecc || return 1
  verify_deep_audit_sandbox || return 1
  if [ ! -f "$DATA_ROOT/deep-audit/data/opencode/auth.json" ]; then
    printf '%s\n' 'Deep Audit uses profile-local OAuth. Start once to connect with /connect openai; the audit will not use a different model.' >&2
  fi
  (
    cd "$target"
    export DEEP_AUDIT_TARGET_ROOT="$target"
    export DEEP_AUDIT_REPORT_ROOT="$DATA_ROOT/deep-audit/reports"
    if [ -n "$resume" ]; then
      start_team deep-audit --resume "$resume"
    else
      start_team deep-audit
    fi
  )
}

verify_best_ecc_assets() {
  local source="$DATA_ROOT/best-ecc/ecc" expected actual
  expected="$(<"$PACKAGE_ROOT/teams/best-ecc/ecc.lock")"
  [ -d "$source/.git" ] || { printf 'BEST-ECC assets missing; run opencode-team best-ecc-setup\n' >&2; return 1; }
  actual="$(git -C "$source" rev-parse HEAD 2>/dev/null || true)"
  [ "$actual" = "$expected" ] || {
    printf 'BEST-ECC source revision mismatch (expected %s, got %s)\n' "$expected" "${actual:-unknown}" >&2
    return 1
  }
  for asset in \
    .opencode/plugins/ecc-hooks.ts \
    .opencode/prompts/agents/tdd-guide.txt \
    skills/tdd-workflow/SKILL.md \
    skills/verification-loop/SKILL.md \
    skills/security-review/SKILL.md \
    skills/agent-harness-construction/SKILL.md; do
    [ -f "$source/$asset" ] || { printf 'BEST-ECC asset missing: %s\n' "$asset" >&2; return 1; }
  done
  printf '  %-18s OK (pinned ECC source %s)\n' "BEST-ECC assets" "$actual"
}

prepare_best_native() {
  local native_runtime="$1" patch_script="$DEPENDENCY_ROOT/best/node_modules/omo-ai/bin/senpi-patch.mjs"
  [ -f "$patch_script" ] || { printf 'BEST Native OMO preparation script missing\n' >&2; return 1; }
  "$native_runtime" "$patch_script"
}

