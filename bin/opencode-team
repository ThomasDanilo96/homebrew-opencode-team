runtime_gc() {
  setup_roots
  local apply=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply) apply=1; shift ;;
      *) printf 'Unknown runtime-gc option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  export PACKAGE_ROOT CONFIG_ROOT DATA_ROOT STATE_ROOT CACHE_ROOT RUNTIME_ROOT DEPENDENCY_ROOT
  if [ "$apply" -eq 1 ]; then
    node "$PACKAGE_ROOT/core/lib/runtime-lifecycle.mjs" gc --apply
  else
    node "$PACKAGE_ROOT/core/lib/runtime-lifecycle.mjs" gc
  fi
}

