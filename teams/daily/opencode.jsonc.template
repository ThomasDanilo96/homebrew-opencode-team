{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "openai_orchestrator",
  "subagent_depth": 1,
  "enabled_providers": ["openai"],
  "disabled_providers": [
    "anthropic", "google", "opencode-go", "opencode-omniroute", "openrouter",
    "bedrock", "vertex", "xai", "mistral", "groq", "cohere", "fireworks",
    "together", "deepinfra", "cerebras", "perplexity", "voyage", "ollama",
    "lmstudio", "litellm"
  ],
  "share": "disabled",
  "autoupdate": "notify",
  "permission": { "*": "allow", "external_directory": "allow", "doom_loop": "allow" },
  "compaction": { "auto": true, "prune": true, "reserved": 24000 },
  "browser_automation_engine": {
    "provider": "playwright",
    "playwright_mcp_args": ["--headless", "--isolated", "--output-dir", "@DATA_ROOT@/daily/playwright/output"]
  },
  "plugin": [
    "@OMO_PLUGIN@",
    "@PACKAGE_ROOT@/teams/openai/config/opencode/openai-team-tools.js",
    "@PACKAGE_ROOT@/teams/openai/config/opencode/openai-authorship-guard.js",
    "@PACKAGE_ROOT@/shared/mac-notifications/plugin.js"
  ],
  "agent": {
    "openai_orchestrator": {
      "mode": "primary",
      "description": "OpenAI Daily orchestrator. Use read, glob, grep, LSP, Serena, and read-only shell directly for repository reconnaissance on explicit paths regardless of the launch directory; use openai_explore when independent analysis is useful. Delegate all repository writes to codex_executor. Daily does not use the BEST router: ignore BEST ROUTE markers if they appear in this profile.",
      "model": "openai/gpt-6-luna",
      "permission": { "task": "allow", "bash": "allow", "interactive_bash": "deny", "read": "allow", "glob": "allow", "grep": "allow", "lsp_*": "allow", "serena_*": "allow", "edit": "deny", "write": "deny", "apply_patch": "deny", "delete": "deny", "rename": "deny", "skill": "deny", "skill_mcp": "allow", "openai_run_codex": "deny", "call_omo_agent": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny", "codegraph_*": "deny" },
      "tools": { "task": true, "bash": true, "interactive_bash": false, "read": true, "glob": true, "grep": true, "rg": true, "list": true, "lsp_*": true, "serena_*": true, "serena_replace_*": false, "serena_insert_*": false, "serena_rename_*": false, "serena_delete_*": false, "serena_write_*": false, "serena_safe_delete_*": false, "serena_edit_*": false, "webfetch": true, "websearch": true, "question": true, "list_mcp_resources": true, "list_mcp_resource_templates": true, "read_mcp_resource": true, "openai_remote_read": true, "openai_run_codex": false, "call_omo_agent": false, "edit": false, "write": false, "apply_patch": false, "delete": false, "rename": false, "skill": false, "skill_mcp": true },
      "prompt_append": "DAILY grants the orchestrator direct read-only access to repository files and discovery tools without tool-count, time, duplicate-search, or mandatory-explorer limits. Use read/glob/grep/LSP/Serena and safe read-only shell commands directly; use openai_explore only when it adds value. Honor user requests for exhaustive audits even when normal guidance would stop after sufficient evidence. Delegate every repository write to codex_executor; do not use root edit/write/patch or mutating Serena tools. Do not substitute lsp_status for Serena symbols, but continue with other read tools if Serena is unavailable. For a mutating objective, inspect directly as needed, then delegate implementation and tests to codex_executor exactly once. Keep existing high-risk verification and review requirements for changes. Never redirect or hand off a Daily task to BEST or another profile."
    },
    "openai_explore": {
      "description": "Read-only repository explorer. Work on the absolute repository paths supplied by the request, not only the current directory. Activate each repository with Serena before semantic navigation; never substitute lsp_* tools for Serena. If Serena or LSP is unavailable, continue with the configured read/glob/grep tools on those paths and report the actual limitation.",
      "model": "openai/gpt-6-luna",
      "permission": { "edit": "deny", "write": "deny", "skill": "allow", "skill_mcp": "allow", "codegraph_*": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false },
        "prompt_append": "Use the absolute repository paths from the task; the process cwd may be HOME or another unrelated directory. For every repository, call serena_activate_project with its path before using Serena symbols, references, structure, or diagnostics. Do not use generic lsp_* tools as a Serena substitute. If Serena activation or a Serena tool fails, continue read-only with read/glob/grep on the explicit path and report the exact failure; do not stop after an unsupported LSP request. Own only the assigned repository slice and return compact evidence. Do not invoke CodeGraph; browser work may use the loaded Playwright skill through skill_mcp without changing repository or remote-mutation permissions."
    },
    "openai_librarian": {
      "description": "Fast OpenAI-only documentation researcher.",
      "model": "openai/gpt-6-luna",
      "permission": { "serena_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false },
      "prompt_append": "Research only the assigned external documentation slice and return source, finding, and consequence compactly."
    },
    "openai_ops": {
      "description": "OpenAI-only read-only remote investigator.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "permission": { "edit": "deny", "write": "deny", "bash": "deny", "task": "deny", "skill": "deny", "serena_*": "deny" },
      "tools": { "openai_remote_read": true, "openai_run_codex": false, "call_omo_agent": false, "bash": false, "task": false, "skill": false }
    },
    "tester": {
      "description": "Focused test and verification worker.",
      "model": "openai/gpt-6-luna",
      "permission": { "apply_patch": "deny", "edit": "deny", "write": "deny", "delete": "deny", "serena_*": "deny", "interactive_bash": "deny", "task": "deny", "skill": "deny" },
      "tools": { "bash": true, "openai_run_codex": false, "call_omo_agent": false, "apply_patch": false, "edit": false, "write": false, "task": false }
    },
    "reviewer": {
      "description": "Balanced read-only correctness and security reviewer.",
      "model": "openai/gpt-5.6-terra",
      "permission": { "edit": "deny", "write": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "reviewer_critical": {
      "description": "Rare critical-risk read-only reviewer.",
      "model": "openai/gpt-6-sol",
      "permission": { "edit": "deny", "write": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "specialist": {
      "description": "Balanced specialist for difficult independent reasoning.",
      "model": "openai/gpt-5.6-terra",
      "permission": { "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "codex_executor": {
      "description": "OpenAI Daily Luna wrapper around the isolated Codex lane.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "permission": {
        "openai_run_codex": "allow",
        "todowrite": "deny",
        "openai_remote_read": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "apply_patch": "deny",
        "edit": "deny",
        "write": "deny",
        "delete": "deny",
        "rename": "deny",
        "bash": "deny",
        "interactive_bash": "deny",
        "shell": "deny",
        "command": "deny",
        "task": "deny",
        "skill": "deny",
        "skill_mcp": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "web": "deny",
        "documentation": "deny",
        "session": "deny",
        "browser": "deny",
        "mcp": "deny",
        "call_omo_agent": "deny",
        "serena_*": "deny"
      },
      "tools": {
        "openai_run_codex": true,
        "todowrite": false,
        "openai_remote_read": false,
        "read": false,
        "glob": false,
        "grep": false,
        "apply_patch": false,
        "edit": false,
        "write": false,
        "delete": false,
        "rename": false,
        "bash": false,
        "interactive_bash": false,
        "shell": false,
        "command": false,
        "task": false,
        "skill": false,
        "webfetch": false,
        "websearch": false,
        "web": false,
        "documentation": false,
        "session": false,
        "browser": false,
        "mcp": false,
        "call_omo_agent": false
      },
      "prompt": "Call openai_run_codex exactly once immediately. The tool already owns the bound objective. Return its structured terminal JSON unchanged. Do not inspect files, run commands, retry, or manufacture fallback."
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  }
}
