{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "openai_orchestrator",
  "subagent_depth": 1,
  "enabled_providers": ["openai"],
  "disabled_providers": [
    "anthropic", "google", "opencode-go", "opencode-omniroute", "openrouter",
    "bedrock", "vertex", "xai", "mistral", "groq", "cohere", "fireworks",
    "together", "deepinfra", "cerebras", "perplexity", "voyage", "ollama",
    "lmstudio", "litellm"
  ],
  "share": "disabled",
  "autoupdate": "notify",
  "compaction": { "auto": true, "prune": true, "reserved": 24000 },
  "plugin": [
    "@OMO_PLUGIN@",
    "@PACKAGE_ROOT@/teams/openai/config/opencode/openai-team-tools.js",
    "@PACKAGE_ROOT@/teams/openai/config/opencode/openai-authorship-guard.js"
  ],
  "agent": {
    "openai_orchestrator": {
      "mode": "primary",
      "description": "Fast, autonomous OpenAI Daily orchestrator.",
      "model": "openai/gpt-5.6-luna",
      "permission": { "task": "allow", "bash": "allow", "edit": "deny", "write": "deny", "skill": "deny", "skill_mcp": "deny", "codegraph_*": "deny", "interactive_bash": "allow" },
      "tools": { "task": true, "bash": true, "interactive_bash": true, "openai_run_codex": false, "call_omo_agent": false },
      "prompt_append": "You are the OPENAI DAILY orchestrator. Optimize for time-to-useful-answer, not exhaustive certainty. Collect the minimum evidence needed for a defensible answer and stop as soon as the requested question is supported, no material contradiction remains, and remaining searches are only confirmatory. Do not perform a final broad pass. Classify before acting: TRIVIAL is direct with no child and about 5 meaningful operations; NORMAL is direct by default with at most one useful Luna child and about 12 weighted operations; COMPLEX uses at most two independent useful children and reassesses at about 20 weighted operations; HEAVY uses at most three children; EXTREME is rare and should be redirected to BEST or OPENAI when exhaustive work is actually required. Launch independent children concurrently, never serially, and only when saved root latency exceeds startup cost. Never begin routine analysis with Glob **/*, broad repository grep, package-lock searches, or binary strings. Prefer exact symbol/path, targeted search, narrow directory, then bounded widening. Do not repeat equivalent searches. Read-only reviews are not certification. For coding tasks inspect narrowly, implement, run the focused relevant test first, and broaden only for shared-core, release-critical, high-risk, or unresolved behavior. Keep depth at one. Use Luna first; use Terra only for a concrete reasoning or review gap; use Sol only for critical/high-risk ambiguity. Do not use Astra. A completed TASK_CACHE_HIT must not be retried. A successful child must not be rerun. Keep handoffs compact: result, evidence, files/symbols, tests, blocker. Codex terminal next_agents is authoritative; when tester is required launch exactly one tester for that exact packet_id; never report final success until every required gate is terminal. Do not ask confirmation for routine reversible development steps. Never use non-OpenAI providers. CodeGraph and skill_mcp are unavailable in DAILY; use the normal read-only repository tools instead."
    },
    "openai_explore": {
      "description": "Fast read-only repository explorer.",
      "model": "openai/gpt-5.6-luna",
      "permission": { "edit": "deny", "write": "deny", "skill_mcp": "deny", "codegraph_*": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false },
      "prompt_append": "Use Serena first for symbols, references, structure, and diagnostics. Own only the assigned repository slice and return compact evidence. Do not invoke CodeGraph or skill_mcp; use the normal read-only repository tools."
    },
    "openai_librarian": {
      "description": "Fast OpenAI-only documentation researcher.",
      "model": "openai/gpt-5.6-luna",
      "permission": { "serena_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false },
      "prompt_append": "Research only the assigned external documentation slice and return source, finding, and consequence compactly."
    },
    "openai_ops": {
      "description": "OpenAI-only read-only remote investigator.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "permission": { "edit": "deny", "write": "deny", "bash": "deny", "task": "deny", "skill": "deny", "serena_*": "deny" },
      "tools": { "openai_remote_read": true, "openai_run_codex": false, "call_omo_agent": false, "bash": false, "task": false, "skill": false }
    },
    "tester": {
      "description": "Focused test and verification worker.",
      "model": "openai/gpt-5.6-luna",
      "permission": { "apply_patch": "deny", "edit": "deny", "write": "deny", "delete": "deny", "serena_*": "deny", "interactive_bash": "deny", "task": "deny", "skill": "deny" },
      "tools": { "bash": true, "openai_run_codex": false, "call_omo_agent": false, "apply_patch": false, "edit": false, "write": false, "task": false }
    },
    "reviewer": {
      "description": "Balanced read-only correctness and security reviewer.",
      "model": "openai/gpt-5.6-terra",
      "permission": { "edit": "deny", "write": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "reviewer_critical": {
      "description": "Rare critical-risk read-only reviewer.",
      "model": "openai/gpt-5.6-sol",
      "permission": { "edit": "deny", "write": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "specialist": {
      "description": "Balanced specialist for difficult independent reasoning.",
      "model": "openai/gpt-5.6-terra",
      "permission": { "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "openai_run_codex": false, "call_omo_agent": false }
    },
    "codex_executor": {
      "description": "OpenAI Daily Luna wrapper around the isolated Codex lane.",
      "model": "openai/gpt-5.6-luna",
      "permission": { "openai_run_codex": "allow", "read": "allow", "glob": "allow", "grep": "allow", "apply_patch": "allow", "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "skill": "deny", "webfetch": "deny", "websearch": "deny", "web": "deny", "session": "deny", "browser": "deny", "mcp": "deny", "call_omo_agent": "deny", "interactive_bash": "deny", "shell": "deny", "command": "deny", "serena_*": "deny" },
      "tools": { "openai_run_codex": true },
      "prompt": "Call openai_run_codex exactly once immediately with the full bound objective. Return its structured terminal JSON unchanged. Never rerun Codex or manufacture fallback."
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  }
}
