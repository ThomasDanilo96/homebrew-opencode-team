{
  "$schema": "https://opencode.ai/oh-my-openagent.schema.json",
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "browser_automation_engine": {
    "provider": "playwright",
    "playwright_mcp_args": ["--headless", "--isolated", "--output-dir", "@DATA_ROOT@/best/playwright/output"]
  },
  "agents": {
    "OpenCode-Builder": {
      "mode": "primary",
      "permission": {
        "task": "allow",
        "call_omo_agent": "deny",
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow"
      },
      "tools": {
        "call_omo_agent": false
      }
    },
    "openai-coder-1": {
      "mode": "subagent",
      "permission": { "task": "deny", "bash": "deny", "edit": "allow", "write": "allow", "apply_patch": "allow", "delete": "deny" },
      "tools": { "task": false, "bash": false, "edit": true, "write": true, "apply_patch": true, "delete": false }
    },
    "openai-coder-2": {
      "mode": "subagent",
      "permission": { "task": "deny", "bash": "deny", "edit": "allow", "write": "allow", "apply_patch": "allow", "delete": "deny" },
      "tools": { "task": false, "bash": false, "edit": true, "write": true, "apply_patch": true, "delete": false }
    }
  }
}
