{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@OMO_PLUGIN@",
    "@PACKAGE_ROOT@/teams/best/best-router-plugin.js",
    "@PACKAGE_ROOT@/shared/mac-notifications/plugin.js"
  ],
  "model": "openai/gpt-6-luna",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "OpenCode-Builder",
  "subagent_depth": 1,
  "permission": { "*": "allow", "skill_mcp": "allow", "external_directory": "allow", "doom_loop": "allow" },
  "tools": {
    "call_omo_agent": false
  },
  "agent": {
    "OpenCode-Builder": {
      "description": "BEST coordinator and integrator. On FANOUT routes, assign disjoint file ownership to openai-coder-1 and openai-coder-2, wait for both results, then launch the reviewer on the resulting diff before integration. Keep simple tasks single-agent.",
      "prompt_append": "When BEST routing guidance contains <BEST_ROUTER_ROUTE>, obey it before any analysis: issue the exact native task call(s) named by the guidance with subagent_type and run_in_background=true. EXPLORE and LIBRARIAN require exactly one matching task; BOTH requires exactly one explore task and one librarian task; FOUR requires exactly one each of explore, librarian, openai-architect, and openai-reviewer, launched in parallel. A bounded read-only root preflight (pwd, git status, or git rev-parse queries, including &&-joined combinations) may run before the required tasks. Do not use broader repository/research tools, substitute agents, retry, launch duplicates, or call call_omo_agent before the required tasks are launched.",
      "permission": {
        "task": "allow",
        "call_omo_agent": "deny",
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow"
      },
      "tools": {
        "call_omo_agent": false
      }
    },
    "explore": {
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "librarian": {
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "openai-architect": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "prompt": "Analyze the requested complex implementation independently. Inspect relevant code and return a concise implementation plan, affected components, constraints, and risks. Do not edit files.",
      "permission": {
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "openai-coder-1": {
      "model": "openai/gpt-6-sol",
      "description": "BEST implementation worker for the first disjoint repository slice.",
      "prompt": "Implement only the exact files and behavior assigned by the Builder. This is a shared worktree: do not touch files outside your owned slice, do not change shared interfaces unless explicitly assigned, and do not delegate. Make the implementation and report files changed plus focused checks still needed.",
      "permission": { "task": "deny", "bash": "deny", "edit": "allow", "write": "allow", "delete": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "task": false, "bash": false, "edit": true, "write": true, "delete": false }
    },
    "openai-coder-2": {
      "model": "openai/gpt-6-luna",
      "description": "BEST implementation worker for the second disjoint repository slice.",
      "prompt": "Implement only the exact files and behavior assigned by the Builder. This is a shared worktree: do not touch files outside your owned slice, do not change shared interfaces unless explicitly assigned, and do not delegate. Make the implementation and report files changed plus focused checks still needed.",
      "permission": { "task": "deny", "bash": "deny", "edit": "allow", "write": "allow", "delete": "deny", "serena_replace_*": "deny", "serena_insert_*": "deny", "serena_rename_*": "deny", "serena_delete_*": "deny", "serena_write_*": "deny", "serena_safe_delete_*": "deny", "serena_edit_*": "deny" },
      "tools": { "task": false, "bash": false, "edit": true, "write": true, "delete": false }
    },
    "openai-reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "prompt": "Independently review the requested implementation requirements. Identify edge cases, compatibility concerns, and focused behavior checks. Do not edit files.",
      "permission": {
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    }
  },
  "disabled_providers": [
    "anthropic", "google", "opencode-omniroute", "openrouter", "bedrock",
    "vertex", "xai", "mistral", "groq", "cohere", "fireworks", "together",
    "deepinfra", "cerebras", "perplexity", "voyage", "ollama", "lmstudio", "litellm"
  ],
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": { "options": { "max_tokens": 32768, "timeout": 300000 } }
  }
}
