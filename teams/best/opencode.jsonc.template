{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@OMO_PLUGIN@",
    "@PACKAGE_ROOT@/teams/best/best-router-plugin.js"
  ],
  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "OpenCode-Builder",
  "subagent_depth": 1,
  "tools": {
    "call_omo_agent": false
  },
  "agent": {
    "OpenCode-Builder": {
      "prompt_append": "When BEST routing guidance contains <BEST_ROUTER_ROUTE>, obey it before any analysis: issue the exact native task call(s) named by the guidance with subagent_type and run_in_background=true. EXPLORE and LIBRARIAN require exactly one matching task and no general substitute or retry; BOTH requires exactly one explore task and exactly one librarian task. Do not call call_omo_agent or use repository/research tools before those route tasks.",
      "permission": {
        "task": "allow",
        "call_omo_agent": "deny",
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow"
      },
      "tools": {
        "call_omo_agent": false
      }
    },
    "explore": {
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "librarian": {
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    }
  },
  "disabled_providers": [
    "anthropic", "google", "opencode-omniroute", "openrouter", "bedrock",
    "vertex", "xai", "mistral", "groq", "cohere", "fireworks", "together",
    "deepinfra", "cerebras", "perplexity", "voyage", "ollama", "lmstudio", "litellm"
  ],
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": { "options": { "max_tokens": 32768, "timeout": 300000 } }
  }
}
