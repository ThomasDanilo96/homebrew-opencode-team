{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file://@DATA_ROOT@/deep-audit/plugins/report-plugin.mjs",
    "file://@DATA_ROOT@/deep-audit/plugins/scanner-plugin.mjs",
    "file://@DATA_ROOT@/deep-audit/plugins/test-runner-plugin.mjs"
  ],
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6.1-sol",
  "enabled_providers": ["openai"],
  "provider": {"openai": {"options": {"timeout": 600000, "chunkTimeout": 60000}}},
  "default_agent": "audit-orchestrator",
  "subagent_depth": 1,
  "skills": {"paths": ["@DEEP_AUDIT_ECC_SOURCE@/skills"]},
  "permission": {
    "*": "deny",
    "read": "allow", "glob": "allow", "grep": "allow", "list": "allow",
    "lsp_*": "allow", "webfetch": "allow", "question": "allow",
    "task": "allow", "deep_audit_save_report": "allow", "deep_audit_scan": "allow",
    "deep_audit_test_discover": "allow", "deep_audit_test_run": "allow",
    "external_directory": {
      "*": "deny",
      "@PACKAGE_ROOT@/teams/deep-audit/**": "allow",
      "@DEEP_AUDIT_ECC_SOURCE@/skills/**": "allow",
      "@DATA_ROOT@/deep-audit/plugins/**": "allow",
      "@DEPENDENCY_ROOT@/python/**": "allow",
      "@DEPENDENCY_ROOT@/bin/serena": "allow",
      "@DEPENDENCY_ROOT@/deep-audit/scanners/**": "allow"
      ,"@REPORT_ROOT@/**": "allow"
      ,"@REPORT_ROOT@/*/**": "allow"
      ,"@REPORT_ROOT@/test-runs/**": "allow"
      ,"@REPORT_ROOT@/scanner-results/**": "allow"
      ,"@DEEP_AUDIT_SERENA_HOME@/logs/**": "allow"
    },
    "serena_*": "allow",
    "serena_replace_*": "deny", "serena_insert_*": "deny",
    "serena_rename_*": "deny", "serena_delete_*": "deny",
    "serena_write_*": "deny", "serena_edit_*": "deny",
    "serena_safe_delete_*": "deny", "serena_open_dashboard": "deny",
    "serena_onboarding": "deny", "serena_create_memory": "deny",
    "bash": "deny", "interactive_bash": "deny", "edit": "deny",
    "write": "deny", "apply_patch": "deny", "delete": "deny",
    "rename": "deny", "skill": "allow", "skill_mcp": "deny"
  },
  "tools": {
    "bash": false, "interactive_bash": false, "edit": false, "write": false,
    "apply_patch": false, "delete": false, "rename": false,
    "call_omo_agent": false, "skill_mcp": false,
    "deep_audit_save_report": true, "deep_audit_scan": true,
    "deep_audit_test_discover": true, "deep_audit_test_run": true,
    "serena_find_declaration": true, "serena_find_implementations": true,
    "serena_find_referencing_symbols": true, "serena_find_symbol": true,
    "serena_get_diagnostics_for_file": true, "serena_get_diagnostics_for_symbol": true,
    "serena_get_symbols_overview": true, "serena_initial_instructions": true,
    "serena_list_memories": true, "serena_read_memory": true, "serena_search_for_pattern": true
