import { tool } from "@OPENCODE_TOOL_MODULE@";
import { lstat, mkdir, open, realpath, rm } from "node:fs/promises";
import path from "node:path";

const sections = [
  ["00_EXECUTIVE_SUMMARY.md", "summary", "Executive summary"],
  ["01_PROJECT_INVENTORY.md", "inventory", "Project inventory"],
  ["02_ARCHITECTURE_REVIEW.md", "architecture", "Architecture review"],
  ["03_CORRECTNESS_AND_BUGS.md", "correctness", "Correctness and bugs"],
  ["04_SECURITY_AUDIT.md", "security", "Security audit"],
  ["05_PERFORMANCE_AUDIT.md", "performance", "Performance audit"],
  ["06_DRY_AND_DUPLICATIONS.md", "dry", "DRY and duplication"],
  ["07_OVERCODING_OVERENGINEERING.md", "simplicity", "Overcoding and overengineering"],
  ["08_TEST_AND_COVERAGE_REPORT.md", "tests", "Tests and coverage"],
  ["09_TECHNICAL_DEBT.md", "technical_debt", "Technical debt"],
  ["10_REMEDIATION_ROADMAP.md", "roadmap", "Remediation roadmap"],
  ["11_VERIFICATION_EVIDENCE.md", "evidence", "Verification evidence"],
  ["12_FINAL_VERDICT.md", "verdict", "Final verdict"],
];
const severityOrder = new Map([["critical", 0], ["high", 1], ["medium", 2], ["low", 3], ["info", 4]]);

function redact(value) {
  return String(value ?? "")
    .replace(/(authorization\s*:\s*bearer\s+)[^\s\n]+/gi, "$1<redacted>")
    .replace(/\b(bearer\s+)[^\s\n]+/gi, "$1<redacted>")
    .replace(/\b((?:GH|GITHUB|AWS|AZURE|OPENAI)_TOKEN|API[_ -]?KEY|PASSWORD|COOKIE|SECRET)\s*[:=]\s*([^\s\n]+)/gi, "$1=<redacted>")
    .replace(/-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?-----END [^-]*PRIVATE KEY-----/gi, "<redacted private key>");
}

function safeJson(value) {
  if (typeof value === "string") return redact(value);
  if (Array.isArray(value)) return value.map(safeJson);
  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, safeJson(item)]));
  return value;
}

function text(value) {
  return redact(value).trim() || "Not reported.";
}

function bullets(items, format = text) {
  return items.length ? items.map((item) => `- ${format(item)}`).join("\n") : "- None reported.";
}

function field(label, value) {
  return `**${label}:** ${text(value)}`;
}

function findingMarkdown(finding) {
  return [
    `## ${text(finding.id)} — ${text(finding.title)}`,
    `${field("Status", finding.status)} · ${field("Severity", finding.severity)} · ${field("Confidence", finding.confidence)} · ${field("Priority", finding.priority)}`,
    field("Files", finding.files.map(text).join(", ")),
    field("Symbols", finding.symbols.map(text).join(", ")),
    field("Observed behavior", finding.observed_behavior),
    field("Expected behavior", finding.expected_behavior),
    field("Root cause", finding.root_cause),
    field("Impact", finding.impact),
    "### Source evidence", bullets(finding.evidence, (item) => `${text(item.path)}:${text(item.lines)} — ${text(item.observation)}`),
    "### Tests", bullets(finding.tests, (item) => `${text(item.command)} — ${text(item.result)} (exit: ${item.exit_code ?? "unknown"})`),
    field("Recommendation", finding.recommendation),
    "**Alternatives**", bullets(finding.alternatives),
    field("Regression risk", finding.regression_risk),
    field("Complexity", finding.complexity),
    field("Dependencies", finding.dependencies.join(", ")),
    field("Verification", finding.verification),
    "**Limitations**", bullets(finding.limitations),
  ].join("\n\n");
}

function isWithin(parent, candidate) {
  const relative = path.relative(parent, candidate);
  return relative === "" || (!relative.startsWith(`..${path.sep}`) && relative !== ".." && !path.isAbsolute(relative));
}

async function assertOwnedDirectory(directory, label) {
  const info = await lstat(directory);
  if (!info.isDirectory() || info.isSymbolicLink()) throw new Error(`${label} must be a real directory, not a symlink`);
  if ((info.mode & 0o077) !== 0) throw new Error(`${label} must be private to the current user`);
  if (typeof process.getuid === "function" && info.uid !== process.getuid()) throw new Error(`${label} must be owned by the current user`);
  return realpath(directory);
}

function assertObject(value, field) {
  if (value === null || typeof value !== "object" || Array.isArray(value)) throw new Error(`${field} must be an object`);
}

function assertKeys(value, keys, field) {
  assertObject(value, field);
  for (const key of keys) if (!Object.hasOwn(value, key)) throw new Error(`${field}.${key} is required`);
  for (const key of Object.keys(value)) if (!keys.includes(key)) throw new Error(`${field}.${key} is not allowed by schema version 1`);
}

function assertString(value, field, { nonempty = false } = {}) {
  if (typeof value !== "string" || (nonempty && !value.trim())) throw new Error(`${field} must be ${nonempty ? "a non-empty " : "a "}string`);
}

function assertNullableString(value, field) {
  if (value !== null) assertString(value, field);
}

function assertNullableInteger(value, field) {
  if (value !== null && (!Number.isInteger(value) || typeof value !== "number")) throw new Error(`${field} must be an integer or null`);
}

function assertStringArray(value, field) {
  if (!Array.isArray(value)) throw new Error(`${field} must be an array`);
  for (const [index, item] of value.entries()) assertString(item, `${field}[${index}]`);
}

function assertEnum(value, values, field) {
  if (!values.includes(value)) throw new Error(`${field} has invalid value ${JSON.stringify(value)}`);
}

const phases = ["inventory", "architecture", "correctness", "security", "dependencies", "performance", "simplicity", "tests", "independent_review"];
const checkKinds = ["Serena", "read", "glob", "grep", "documentation", "scanner", "test"];
const findingStatuses = ["CONFIRMED", "PROBABLE", "UNVERIFIED", "FALSE_POSITIVE", "NOT_EXECUTED"];
const categories = ["architecture", "correctness", "security", "dependencies", "performance", "dry", "overengineering", "simplicity", "tests", "technical_debt", "other"];
const priorities = ["P0", "P1", "P2", "P3"];

function validateReport(report) {
  assertKeys(report, ["schema_version", "scope", "inventory", "method", "execution", "findings", "coverage_gaps", "limitations", "summary"], "report");
  if (report.schema_version !== 1) throw new Error("report.schema_version must be 1");
  assertKeys(report.scope, ["requested", "examined", "excluded"], "report.scope");
  assertString(report.scope.requested, "report.scope.requested", { nonempty: true });
  assertStringArray(report.scope.examined, "report.scope.examined");
  assertStringArray(report.scope.excluded, "report.scope.excluded");

  assertKeys(report.inventory, ["stack", "structure", "components", "entry_points", "dependencies", "test_suites", "boundaries"], "report.inventory");
  for (const key of ["stack", "structure", "components", "entry_points", "dependencies", "test_suites", "boundaries"]) assertStringArray(report.inventory[key], `report.inventory.${key}`);

  assertKeys(report.method, ["phases_completed", "checks"], "report.method");
  assertStringArray(report.method.phases_completed, "report.method.phases_completed");
  const completedPhases = new Set();
  for (const [index, phase] of report.method.phases_completed.entries()) {
    assertEnum(phase, phases, `report.method.phases_completed[${index}]`);
    if (completedPhases.has(phase)) throw new Error(`report.method.phases_completed contains duplicate phase ${phase}`);
    completedPhases.add(phase);
  }
  if (!Array.isArray(report.method.checks)) throw new Error("report.method.checks must be an array");
  for (const [index, check] of report.method.checks.entries()) {
    const field = `report.method.checks[${index}]`;
    assertKeys(check, ["kind", "target", "result", "command", "exit_code"], field);
    assertEnum(check.kind, checkKinds, `${field}.kind`);
    assertString(check.target, `${field}.target`, { nonempty: true });
    assertString(check.result, `${field}.result`);
    assertNullableString(check.command, `${field}.command`);
    assertNullableInteger(check.exit_code, `${field}.exit_code`);
    if (check.command === null && check.exit_code !== null) throw new Error(`${field}.exit_code requires a command`);
  }

  assertKeys(report.execution, ["target_commit", "models_used", "tool_versions", "commands"], "report.execution");
  assertNullableString(report.execution.target_commit, "report.execution.target_commit");
  if (!Array.isArray(report.execution.models_used)) throw new Error("report.execution.models_used must be an array");
  for (const [index, model] of report.execution.models_used.entries()) {
    const field = `report.execution.models_used[${index}]`;
    assertKeys(model, ["agent", "configured_model_id", "model_id", "reasoning", "identity_source", "provider_attested"], field);
    assertString(model.agent, `${field}.agent`, { nonempty: true });
    assertNullableString(model.configured_model_id, `${field}.configured_model_id`);
    assertString(model.model_id, `${field}.model_id`, { nonempty: true });
    if (model.model_id !== "unknown" && !/^[A-Za-z0-9][A-Za-z0-9._-]*\/[A-Za-z0-9][A-Za-z0-9._/-]*$/.test(model.model_id)) throw new Error(`${field}.model_id must be an observed provider/model ID or unknown`);
    assertString(model.reasoning, `${field}.reasoning`, { nonempty: true });
    if (!/^[A-Za-z0-9][A-Za-z0-9._/-]*$/.test(model.reasoning)) throw new Error(`${field}.reasoning must be an observable configuration variant or unknown, not a claim about hidden reasoning`);
    assertEnum(model.identity_source, ["session_database", "session_metadata", "visible_tui", "specialist_statement", "unknown"], `${field}.identity_source`);
    if (typeof model.provider_attested !== "boolean") throw new Error(`${field}.provider_attested must be a boolean`);
    if (model.provider_attested) throw new Error(`${field}.provider_attested cannot be true without provider-side attestation evidence`);
  }
  assertObject(report.execution.tool_versions, "report.execution.tool_versions");
  for (const [tool, version] of Object.entries(report.execution.tool_versions)) assertString(version, `report.execution.tool_versions.${tool}`, { nonempty: true });
  if (!Array.isArray(report.execution.commands)) throw new Error("report.execution.commands must be an array");
  for (const [index, command] of report.execution.commands.entries()) {
    const field = `report.execution.commands[${index}]`;
    assertKeys(command, ["command", "exit_code", "status"], field);
    assertString(command.command, `${field}.command`, { nonempty: true });
    assertNullableInteger(command.exit_code, `${field}.exit_code`);
    assertEnum(command.status, ["passed", "failed", "completed_with_findings", "not_executed"], `${field}.status`);
    if ((command.status === "not_executed") !== (command.exit_code === null)) throw new Error(`${field}.exit_code must be null exactly when the command was not executed`);
  }

  if (!Array.isArray(report.findings)) throw new Error("report.findings must be an array");
  const findingIds = new Set();
  const findingFingerprints = new Map();
  for (const [index, finding] of report.findings.entries()) {
    const field = `report.findings[${index}]`;
    assertKeys(finding, ["id", "status", "severity", "confidence", "category", "title", "files", "symbols", "evidence", "observed_behavior", "expected_behavior", "root_cause", "impact", "tests", "recommendation", "alternatives", "regression_risk", "dependencies", "priority", "complexity", "verification", "limitations"], field);
    assertString(finding.id, `${field}.id`, { nonempty: true });
    if (findingIds.has(finding.id)) throw new Error(`${field}.id duplicates ${finding.id}`);
    findingIds.add(finding.id);
    assertEnum(finding.status, findingStatuses, `${field}.status`);
    assertEnum(finding.severity, [...severityOrder.keys()], `${field}.severity`);
    assertEnum(finding.confidence, ["high", "medium", "low"], `${field}.confidence`);
    assertEnum(finding.category, categories, `${field}.category`);
    assertString(finding.title, `${field}.title`, { nonempty: true });
    assertStringArray(finding.files, `${field}.files`);
    assertStringArray(finding.symbols, `${field}.symbols`);
    if (!Array.isArray(finding.evidence)) throw new Error(`${field}.evidence must be an array`);
    for (const [evidenceIndex, evidence] of finding.evidence.entries()) {
      const evidenceField = `${field}.evidence[${evidenceIndex}]`;
      assertKeys(evidence, ["path", "lines", "observation"], evidenceField);
      assertString(evidence.path, `${evidenceField}.path`, { nonempty: true });
      assertString(evidence.lines, `${evidenceField}.lines`, { nonempty: true });
      assertString(evidence.observation, `${evidenceField}.observation`, { nonempty: true });
    }
    if (["CONFIRMED", "PROBABLE"].includes(finding.status) && !finding.evidence.length) throw new Error(`${field}.evidence is required for ${finding.status} findings`);
    for (const key of ["observed_behavior", "expected_behavior", "root_cause", "impact", "recommendation", "regression_risk", "verification"]) assertString(finding[key], `${field}.${key}`);
    const normalize = (value) => value.trim().toLowerCase().replace(/\s+/g, " ");
    const fingerprint = JSON.stringify([
      finding.category,
      normalize(finding.title),
      normalize(finding.root_cause),
      [...finding.files].map((file) => file.replaceAll("\\", "/").toLowerCase()).sort(),
      [...finding.symbols].map(normalize).sort(),
    ]);
    if (findingFingerprints.has(fingerprint)) throw new Error(`${field} duplicates finding ${findingFingerprints.get(fingerprint)} by category, title, root cause, files, and symbols`);
    findingFingerprints.set(fingerprint, finding.id);
    if (!Array.isArray(finding.tests)) throw new Error(`${field}.tests must be an array`);
    for (const [testIndex, command] of finding.tests.entries()) {
      const testField = `${field}.tests[${testIndex}]`;
      assertKeys(command, ["command", "result", "exit_code"], testField);
      assertString(command.command, `${testField}.command`, { nonempty: true });
      assertEnum(command.result, ["passed", "failed", "not_executed"], `${testField}.result`);
      assertNullableInteger(command.exit_code, `${testField}.exit_code`);
      if ((command.result === "not_executed") !== (command.exit_code === null)) throw new Error(`${testField}.exit_code must be null exactly when the test was not executed`);
    }
    assertStringArray(finding.alternatives, `${field}.alternatives`);
    assertStringArray(finding.dependencies, `${field}.dependencies`);
    assertEnum(finding.priority, priorities, `${field}.priority`);
    assertEnum(finding.complexity, ["low", "medium", "high"], `${field}.complexity`);
    assertStringArray(finding.limitations, `${field}.limitations`);
  }
  const byId = new Map(report.findings.map((finding) => [finding.id, finding]));
  for (const [index, finding] of report.findings.entries()) {
    for (const [dependencyIndex, id] of finding.dependencies.entries()) {
      const field = `report.findings[${index}].dependencies[${dependencyIndex}]`;
      if (!byId.has(id)) throw new Error(`${field} references an unknown finding: ${id}`);
      if (priorities.indexOf(byId.get(id).priority) > priorities.indexOf(finding.priority)) throw new Error(`${field} has a lower-priority prerequisite: ${id}`);
    }
  }
  const visiting = new Set();
  const visited = new Set();
  function visit(id) {
    if (visiting.has(id)) throw new Error(`report.findings.dependencies contains a cycle at ${id}`);
    if (visited.has(id)) return;
    visiting.add(id);
    for (const dependency of byId.get(id).dependencies) visit(dependency);
    visiting.delete(id);
    visited.add(id);
  }
  for (const id of byId.keys()) visit(id);
  assertStringArray(report.coverage_gaps, "report.coverage_gaps");
  assertStringArray(report.limitations, "report.limitations");
  assertString(report.summary, "report.summary", { nonempty: true });
}

function roadmapOrder(findings) {
  const byId = new Map(findings.map((finding) => [finding.id, finding]));
  const ordered = [];
  const visited = new Set();
  function visit(finding) {
    if (visited.has(finding.id)) return;
    for (const id of finding.dependencies) visit(byId.get(id));
    visited.add(finding.id);
    ordered.push(finding);
  }
  for (const finding of [...findings].sort((a, b) => priorities.indexOf(a.priority) - priorities.indexOf(b.priority) || a.id.localeCompare(b.id))) visit(finding);
  return ordered;
}

function sectionContent(report, key) {
  const findings = [...report.findings].sort((a, b) => (severityOrder.get(a.severity) - severityOrder.get(b.severity)) || a.id.localeCompare(b.id));
  const gaps = `## Coverage gaps\n\n${bullets(report.coverage_gaps)}\n\n## Limitations\n\n${bullets(report.limitations)}`;
  if (key === "summary") return `${text(report.summary)}\n\n${field("Requested scope", report.scope.requested)}\n\n${field("Recorded findings", findings.length)}\n\n${field("Completed phases", report.method.phases_completed.join(", "))}\n\n${gaps}`;
  if (key === "inventory") return [
    field("Requested scope", report.scope.requested),
    "## Stack", bullets(report.inventory.stack),
    "## Project structure", bullets(report.inventory.structure),
    "## Components", bullets(report.inventory.components),
    "## Files and components examined", bullets(report.scope.examined),
    "## Entry points", bullets(report.inventory.entry_points),
    "## Dependencies", bullets(report.inventory.dependencies),
    "## Test suites", bullets(report.inventory.test_suites),
    "## Boundaries", bullets(report.inventory.boundaries),
    "## Exclusions", bullets(report.scope.excluded),
    "## Completed phases", bullets(report.method.phases_completed),
    "## Inspection checks", bullets(report.method.checks, (check) => `${text(check.kind)} — ${text(check.target)}: ${text(check.result)}${check.command === null ? "" : `; command: ${text(check.command)}`}${check.exit_code === null ? "" : `; exit: ${check.exit_code}`}`),
    gaps,
  ].join("\n\n");
  if (key === "roadmap") {
    if (!findings.length) return noFindingSummary("Remediation roadmap", report);
    return roadmapOrder(findings).map((finding) => `## ${finding.priority} — ${text(finding.title)} (${text(finding.id)})\n\n${field("Status", finding.status)} · ${field("Severity", finding.severity)} · ${field("Complexity", finding.complexity)}\n\n${field("Dependencies", finding.dependencies.join(", "))}\n\n${field("Recommendation", finding.recommendation)}\n\n${field("Verification", finding.verification)}\n\n${field("Regression risk", finding.regression_risk)}`).join("\n\n");
  }
  if (key === "evidence") return [
    "## Inspection checks", bullets(report.method.checks, (check) => `${text(check.kind)} — ${text(check.target)}: ${text(check.result)}; command: ${text(check.command)}; exit: ${check.exit_code ?? "unknown"}`),
    "## Executed commands", bullets(report.execution.commands, (command) => `${text(command.command)} — ${text(command.status)} (exit: ${command.exit_code ?? "unknown"})`),
    "## Finding evidence", findings.length ? findings.map((finding) => `### ${text(finding.id)} — ${text(finding.title)} (${text(finding.status)})\n\n${bullets(finding.evidence, (item) => `${text(item.path)}:${text(item.lines)} — ${text(item.observation)}`)}\n\n**Tests**\n\n${bullets(finding.tests, (item) => `${text(item.command)} — ${text(item.result)} (exit: ${item.exit_code ?? "unknown"})`)}\n\n${field("Verification", finding.verification)}`).join("\n\n") : "No findings were recorded; this does not establish a defect-free scope.",
    "## Reported execution metadata (not provider-attested)",
    field("Target commit", report.execution.target_commit),
    "### Models and provenance", bullets(report.execution.models_used, (model) => `${text(model.agent)} — configured: ${text(model.configured_model_id)}; runtime: ${text(model.model_id)}; variant: ${text(model.reasoning)}; source: ${text(model.identity_source)}; provider-attested: ${model.provider_attested ? "yes" : "no"}`),
    "**Tool versions**", bullets(Object.entries(report.execution.tool_versions), ([tool, version]) => `${text(tool)}: ${text(version)}`),
    gaps,
  ].join("\n\n");
  if (key === "verdict") return [text(report.summary), field("Recorded findings", findings.length),
    "## Findings by status", bullets(findingStatuses.map((status) => `${status}: ${findings.filter((finding) => finding.status === status).length}`)),
    "## Completed phases", bullets(report.method.phases_completed),
    "Uncompleted phases and unexamined scope are not verified. An absence of findings does not establish a clean bill of health.", gaps,
  ].join("\n\n");
  const routes = {
    architecture: ["architecture"], correctness: ["correctness"], security: ["security"], performance: ["performance"],
    dry: ["dry"], simplicity: ["overengineering", "simplicity"], tests: ["tests"],
    technical_debt: ["technical_debt", "dependencies", "other"],
  };
  const selected = findings.filter((finding) => routes[key].includes(finding.category));
  return selected.length ? selected.map(findingMarkdown).join("\n\n") : noFindingSummary(sections.find((section) => section[1] === key)?.[2] ?? key, report, key);
}

function noFindingSummary(title, report, key) {
  const limitations = [...report.coverage_gaps, ...report.limitations];
  const coverage = limitations.length
    ? `\n\n## Coverage gaps and limitations\n\n${bullets(limitations)}`
    : "\n\nReview completed phases and verification evidence before interpreting this section; absence of a finding is not proof that the area is defect-free.";
  const phase = ({ dry: "simplicity", simplicity: "simplicity" })[key] ?? key;
  const assessment = phase && phases.includes(phase) && !report.method.phases_completed.includes(phase)
    ? ` The ${phase} phase was not reported as completed; this area is not fully assessed.` : "";
  return `${title}: no evidence-backed findings were recorded. This is not a clean bill of health.${assessment}${coverage}`;
}

export default async () => ({
  tool: {
    deep_audit_save_report: tool({
      description: "Validate and save a completed Deep Audit JSON report only inside the profile-owned reports directory, never inside the audited project.",
      args: {
        audit_id: tool.schema.string().regex(/^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$/),
        report_json: tool.schema.string().min(2).max(8_000_000),
      },
      async execute({ audit_id, report_json }, context) {
        const reportRoot = process.env.DEEP_AUDIT_REPORT_ROOT;
        if (!reportRoot || !path.isAbsolute(reportRoot)) throw new Error("DEEP_AUDIT_REPORT_ROOT is not configured");
        const targetRoot = process.env.DEEP_AUDIT_TARGET_ROOT;
        if (!targetRoot || !path.isAbsolute(targetRoot)) throw new Error("DEEP_AUDIT_TARGET_ROOT is not configured");
        const project = await realpath(targetRoot);
        let root = await realpath(reportRoot).catch(async (error) => {
          if (error?.code !== "ENOENT") throw error;
          const parent = await realpath(path.dirname(reportRoot));
          const candidate = path.join(parent, path.basename(reportRoot));
          if (isWithin(project, candidate)) throw new Error("report root must be outside the audited project");
          await mkdir(candidate, { recursive: false, mode: 0o700 });
          return realpath(candidate);
        });
        root = await assertOwnedDirectory(reportRoot, "report root");
        if (isWithin(project, root)) throw new Error("report root must be outside the audited project");
        const report = safeJson(JSON.parse(report_json));
        validateReport(report);
        const destination = path.join(root, audit_id);
        await mkdir(destination, { recursive: false, mode: 0o700 });
        await assertOwnedDirectory(destination, "audit destination");
        const documents = {
          "findings.json": `${JSON.stringify(report, null, 2)}\n`,
          "execution-manifest.json": `${JSON.stringify({ schema_version: 1, audit_id, created_at: new Date().toISOString(), target: report.scope.requested, project_worktree: project, execution: report.execution, model_usage_independently_verified: false, phases_completed: report.method.phases_completed, coverage_gaps: report.coverage_gaps, limitations: report.limitations }, null, 2)}\n`,
           ...Object.fromEntries(sections.map(([filename, key, title]) => [filename, `# ${title}\n\n${sectionContent(report, key)}\n`])),
        };
        try {
          for (const [filename, contents] of Object.entries(documents)) {
            await assertOwnedDirectory(root, "report root");
            await assertOwnedDirectory(destination, "audit destination");
            const file = path.join(destination, filename);
            const handle = await open(file, "wx", 0o600);
            try {
              await handle.writeFile(contents, "utf8");
              await handle.sync();
            } finally {
              await handle.close();
            }
            const canonicalFile = await realpath(file);
            const fileInfo = await lstat(file);
            if (!isWithin(root, canonicalFile) || !fileInfo.isFile() || fileInfo.isSymbolicLink() || (fileInfo.mode & 0o077) !== 0) throw new Error(`report file escaped its private destination or has unsafe permissions: ${filename}`);
          }
        } catch (error) {
          await rm(destination, { recursive: true, force: true });
          throw error;
        }
        return { title: `Saved audit ${audit_id}`, output: `Validated report saved outside the project: ${destination}`, metadata: { audit_id, report_root: root, findings: report.findings.length } };
      },
    }),
  },
});
