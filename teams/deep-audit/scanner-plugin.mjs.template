import { tool } from "@OPENCODE_TOOL_MODULE@";
import { chmod, lstat, mkdir, mkdtemp, readFile, realpath, rm, rmdir, writeFile } from "node:fs/promises";
import { spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import path from "node:path";

const OUTPUT_LIMIT = 400_000;
const redact = (value) => String(value ?? "")
  .replace(/(authorization\s*:\s*bearer\s+)[^\s\n]+/gi, "$1<redacted>")
  .replace(/\b(bearer\s+)[^\s\n]+/gi, "$1<redacted>")
  .replace(/\b([A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|COOKIE|CREDENTIAL|API[_-]?KEY|ACCESS[_-]?KEY|AUTHORIZATION)[A-Z0-9_]*)\s*[:=]\s*(?:"[^"]*"|'[^']*'|[^\s,;]+)/gi, "$1=<redacted>")
  .replace(/\b(?:ghp|github_pat|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{20,}\b/g, "<redacted GitHub token>")
  .replace(/\bAKIA[0-9A-Z]{16}\b/g, "<redacted AWS access key>")
  .replace(/\bsk-[A-Za-z0-9_-]{20,}\b/g, "<redacted API key>")
  .replace(/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/g, "<redacted JWT>")
  .replace(/([A-Za-z][A-Za-z0-9+.-]*:\/\/)[^/@\s:]+:[^/@\s]+@/g, "$1<redacted>@")
  .replace(/-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?-----END [^-]*PRIVATE KEY-----/gi, "<redacted private key>");

const skippedScanDirs = new Set([".git", ".hg", ".svn", "node_modules", "vendor", ".venv", "venv", "__pycache__", ".tox", "dist", "build", "target"]);
const osvSourcePattern = /^(?:package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|go\.sum|poetry\.lock|Pipfile\.lock|requirements(?:[-_.][^/]*)?\.txt|Gemfile\.lock|composer\.lock|pom\.xml|gradle\.lockfile|pubspec\.lock|mix\.lock|packages\.lock\.json|Package\.resolved|uv\.lock|deno\.lock|bun\.lock(?:b)?)$/i;

async function listTargetFiles(root, relative = "") {
  const files = [];
  for (const entry of await (await import("node:fs/promises")).readdir(path.join(root, relative), { withFileTypes: true })) {
    const child = path.join(relative, entry.name);
    if (entry.isDirectory()) {
      if (!skippedScanDirs.has(entry.name)) files.push(...await listTargetFiles(root, child));
    } else if (entry.isFile()) files.push(child.split(path.sep).join("/"));
  }
  return files;
}

async function writeSkippedEvidence({ scanner, target, context, resultDir, reason }) {
  const id = `${scanner}-${Date.now()}-${randomUUID()}`;
  const output = path.join(resultDir, `${id}.json`);
  const evidence = {
    schema_version: 1,
    scanner,
    target: path.relative(context.worktree ?? context.directory, target),
    status: "NOT_EXECUTED",
    applicability: "NOT_APPLICABLE",
    exit_code: null,
    reason,
    analysis_scope: { root: path.relative(context.worktree ?? context.directory, target), recursive: true, command: null },
  };
  await writeFile(output, `${JSON.stringify(evidence, null, 2)}\n`, { encoding: "utf8", mode: 0o600, flag: "wx" });
  return { title: `${scanner}: NOT_APPLICABLE`, output: `Scan evidence saved outside the target: ${output}\n\n${JSON.stringify(evidence, null, 2)}` };
}

function summarizedFindings(scanner, result, sidecar, target) {
  const parse = (value) => { try { return JSON.parse(value); } catch { return null; } };
  const source = scanner === "gitleaks" ? parse(sidecar) : scanner === "jscpd" ? parse(sidecar) : parse(result.stdout);
  if (scanner === "ast-grep") {
    const items = Array.isArray(source) ? source : Array.isArray(source?.matches) ? source.matches : Array.isArray(source?.findings) ? source.findings : null;
    if (items) {
      const findings = items.map((item) => ({
        rule_id: item.ruleId ?? item.rule_id ?? item.id ?? null,
        path: (item.file ?? item.path ?? item.filePath) ? path.relative(target, item.file ?? item.path ?? item.filePath) : null,
        start_line: item.range?.start?.line != null ? item.range.start.line + 1 : item.start?.line ?? item.line ?? null,
        end_line: item.range?.end?.line != null ? item.range.end.line + 1 : item.end?.line ?? null,
        severity: item.severity ?? null,
        message: redact(item.message ?? item.note ?? ""),
      }));
      return { result_count: findings.length, findings };
    }
  }
  if (scanner === "semgrep" && source && Array.isArray(source.results)) {
    return { scanner_version: source.version ?? null, finding_count: source.results.length, errors: (source.errors ?? []).map((item) => ({ code: item.code ?? null, message: redact(item.message ?? "") })), findings: source.results.map((item) => ({ rule_id: item.check_id ?? null, path: item.path ?? null, start_line: item.start?.line ?? null, end_line: item.end?.line ?? null, severity: item.extra?.severity ?? null, message: redact(item.extra?.message ?? "") })) };
  }
  if (scanner === "gitleaks" && Array.isArray(source)) {
    return { finding_count: source.length, findings: source.map((item) => ({ rule_id: item.RuleID ?? null, file: item.File ?? null, line: item.StartLine ?? null, description: redact(item.Description ?? "") })) };
  }
  if (scanner === "jscpd" && source && Array.isArray(source.duplicates)) {
    return { duplicate_count: source.duplicates.length, statistics: source.statistics?.total ?? null, formats: source.statistics?.formats ?? {}, duplicates: source.duplicates.map((item) => ({ format: item.format ?? null, lines: item.lines ?? null, tokens: item.tokens ?? null, first: { file: item.firstFile?.name ?? item.firstFile?.path ?? null, line: item.firstFile?.start?.line ?? null }, second: { file: item.secondFile?.name ?? item.secondFile?.path ?? null, line: item.secondFile?.start?.line ?? null } })) };
  }
  if (scanner === "sqlfluff" && Array.isArray(source)) {
    const findings = source.flatMap((file) => (file.violations ?? []).map((item) => ({ id: item.code ?? null, path: file.filepath ?? null, line: item.start_line_no ?? null, severity: item.severity ?? null, message: redact(item.description ?? "") })));
    return { result_count: findings.length, findings };
  }
  if (Array.isArray(source)) {
    return {
      result_count: source.length,
      findings: source.map((item) => ({ id: item.code ?? item.rule_id ?? item.check_id ?? null, path: item.filename ?? item.file ?? item.path ?? null, line: item.location?.row ?? item.start?.line ?? item.line ?? null, severity: item.severity ?? item.issue_severity ?? null, message: redact(item.message ?? item.issue_text ?? item.title ?? item.description ?? "") })),
    };
  }
  if (scanner === "vulture") {
    const findings = (result.stdout ?? "").split(/\r?\n/).flatMap((line) => {
      const match = line.match(/^(.+?):(\d+):\s*unused\s+(function|class|variable|attribute|property|import|method)\s+["']?([^"']+?)["']?(?:\s+\((\d+)% confidence\))?\s*$/i);
      return match ? [{ path: match[1], line: Number(match[2]), kind: match[3].toLowerCase(), name: redact(match[4]), confidence: match[5] ? Number(match[5]) : null }] : [];
    });
    return { result_count: findings.length, findings, stdout_bytes: Buffer.byteLength(result.stdout ?? ""), stderr_bytes: Buffer.byteLength(result.stderr ?? "") };
  }
  if (source && typeof source === "object") {
    const results = source.results ?? source.findings ?? source.vulnerabilities ?? source.matches ?? source.issues;
    if (Array.isArray(results)) return {
      result_count: results.length,
      findings: results.map((item) => ({
        id: item.id ?? item.code ?? item.rule_id ?? item.check_id ?? null,
        path: item.path ?? item.file ?? item.filename ?? null,
        line: item.line ?? item.start?.line ?? item.location?.row ?? null,
        severity: item.severity ?? item.issue_severity ?? null,
        message: redact(item.message ?? item.issue_text ?? item.title ?? ""),
        unused_files: Array.isArray(item.files) ? item.files.map((file) => file.name ?? file.path ?? null).filter(Boolean) : [],
        unused_dependencies: Array.isArray(item.dependencies) ? item.dependencies.map((dependency) => dependency.name ?? dependency).filter(Boolean) : [],
      })),
    };
  }
  const diagnostics = redact(result.stderr ?? "").split(/\r?\n/).map((line) => line.trim()).filter(Boolean).slice(0, 40);
  return { structured_result_available: source !== null, stdout_bytes: Buffer.byteLength(result.stdout ?? ""), stderr_bytes: Buffer.byteLength(result.stderr ?? ""), diagnostics, message: result.exit_code === 0 ? "Scanner completed; no structured finding summary was available." : redact(result.stderr || result.stdout).slice(0, 4000) };
}

function within(parent, child) {
  const relative = path.relative(parent, child);
  return relative === "" || (!relative.startsWith(`..${path.sep}`) && relative !== ".." && !path.isAbsolute(relative));
}

async function assertPrivateDirectory(directory, label) {
  const info = await lstat(directory);
  if (!info.isDirectory() || info.isSymbolicLink()) throw new Error(`${label} must be a real directory, not a symlink`);
  if ((info.mode & 0o077) !== 0) throw new Error(`${label} must be private to the current user`);
  if (typeof process.getuid === "function" && info.uid !== process.getuid()) throw new Error(`${label} must be owned by the current user`);
  return realpath(directory);
}

function commandFor(scanner, target, output, root, rules, dialect, requirements = []) {
  const nodeBin = path.join(root, "node", "node_modules", ".bin");
  const pythonBin = path.join(root, "python", "bin");
  const binary = path.join(root, "bin");
  const table = {
    jscpd: [path.join(nodeBin, "jscpd"), [
      "--min-lines", "1", "--min-tokens", "1", "--fail-on-empty",
      "--pattern", "**/*.{js,jsx,ts,tsx,mjs,cjs,py,java,kt,kts,scala,cs,go,rs,c,cc,cpp,h,hpp,php,rb,swift,clj,sql,html,css,scss,md}",
      "--ignore", "**/.git/**,**/node_modules/**,**/vendor/**,**/.venv/**,**/venv/**,**/dist/**,**/build/**",
      "--reporters", "json", "--output", path.dirname(output), target,
    ]],
    "ast-grep": [path.join(nodeBin, "ast-grep"), ["scan", "--json=compact", "--rule", path.join(rules, "ast-grep.yml"), target]],
    semgrep: [path.join(pythonBin, "semgrep"), ["scan", "--config", path.join(rules, "semgrep.yml"), "--json", "--metrics=off", target]],
    gitleaks: [path.join(binary, "gitleaks"), ["detect", "--no-git", "--source", target, "--report-format", "json", "--report-path", `${output}.gitleaks.json`, "--redact", "--exit-code", "0"]],
    "osv-scanner": [path.join(binary, "osv-scanner"), ["scan", "source", "--recursive", "--format", "json", target]],
    ruff: [path.join(pythonBin, "ruff"), ["check", "--no-cache", "--output-format", "json", target]],
    vulture: [path.join(pythonBin, "vulture"), [target, "--min-confidence", "80"]],
    bandit: [path.join(pythonBin, "bandit"), ["-r", target, "-f", "json", "-q", "--exit-zero"]],
    sqlfluff: [path.join(pythonBin, "sqlfluff"), ["lint", "--format", "json", "--dialect", dialect, target]],
    knip: [path.join(nodeBin, "knip"), ["--reporter", "json", "--directory", target]],
  };
  if (scanner === "pip-audit") return [path.join(pythonBin, "pip-audit"), [...requirements.flatMap((file) => ["-r", path.join(target, file)]), "--format", "json"]];
  return table[scanner];
}

async function executeScanner(scanner, dialect, context) {
  const targetValue = process.env.DEEP_AUDIT_TARGET_ROOT;
  const reportValue = process.env.DEEP_AUDIT_REPORT_ROOT;
  if (!targetValue || !reportValue || !process.env.DEEP_AUDIT_SCANNER_ROOT || !process.env.DEEP_AUDIT_RULES_ROOT) throw new Error("Deep Audit scanner environment is incomplete");
  const scannerRoot = await realpath(process.env.DEEP_AUDIT_SCANNER_ROOT);
  const ruleRoot = await realpath(process.env.DEEP_AUDIT_RULES_ROOT);
  const target = await realpath(targetValue);
  const reportRoot = await assertPrivateDirectory(reportValue, "scanner report root");
  if (within(target, reportRoot)) throw new Error("scanner output must be outside the audited project");
  if (path.resolve(context.directory) !== target) throw new Error("scanner target differs from the active project");
  const files = await listTargetFiles(target);
  const requirements = files.filter((file) => /(^|\/)requirements(?:-[^/]+)?\.txt$/i.test(file) || /^requirements\/.*\.txt$/i.test(file));
  const osvSources = files.filter((file) => osvSourcePattern.test(path.posix.basename(file)));
  const session = String(context.sessionID ?? "audit").replace(/[^A-Za-z0-9_-]/g, "_");
  const resultDir = path.join(reportRoot, "scanner-results", session);
  await mkdir(resultDir, { recursive: true, mode: 0o700 });
  await assertPrivateDirectory(resultDir, "scanner evidence directory");
  if (scanner === "pip-audit" && requirements.length === 0) return writeSkippedEvidence({ scanner, target, context, resultDir, reason: "NOT_APPLICABLE: no supported requirements*.txt file exists in the audited tree; no pip-audit process was started." });
  if (scanner === "osv-scanner" && osvSources.length === 0) return writeSkippedEvidence({ scanner, target, context, resultDir, reason: "NOT_APPLICABLE: no supported dependency lockfile or manifest was found recursively; package.json alone is not treated as a resolved dependency graph." });
  const pythonSources = files.filter((file) => /\.(?:py|pyi)$/i.test(file));
  if (["ast-grep", "ruff", "vulture", "bandit"].includes(scanner) && pythonSources.length === 0) return writeSkippedEvidence({ scanner, target, context, resultDir, reason: `NOT_APPLICABLE: the pinned ${scanner} configuration only covers Python sources, and no Python source file exists in the audited tree.` });
  if (scanner === "sqlfluff" && !files.some((file) => /\.sql$/i.test(file))) return writeSkippedEvidence({ scanner, target, context, resultDir, reason: "NOT_APPLICABLE: no SQL source file exists in the audited tree." });
  if (scanner === "knip" && !files.some((file) => /(^|\/)package\.json$/i.test(file))) return writeSkippedEvidence({ scanner, target, context, resultDir, reason: "NOT_APPLICABLE: no JavaScript package manifest exists in the audited tree." });
  const runDir = path.join(resultDir, `${scanner}-${Date.now()}-${randomUUID()}`);
  await mkdir(runDir, { recursive: false, mode: 0o700 });
  const output = path.join(runDir, "evidence.json");
  const [executable, args] = commandFor(scanner, target, output, scannerRoot, ruleRoot, dialect, requirements);
  const canonicalExecutable = await realpath(executable).catch(() => null);
  if (!canonicalExecutable || !within(scannerRoot, canonicalExecutable)) throw new Error("scanner executable is outside the profile-owned scanner root");
  try { await realpath(executable); }
  catch { return { title: `${scanner} unavailable`, output: `Pinned profile scanner missing: ${executable}` }; }

  const tempBase = process.env.DEEP_AUDIT_SCANNER_TMP_ROOT || path.join(reportRoot, ".scanner-work");
  await mkdir(tempBase, { recursive: true, mode: 0o700 });
  const tempRoot = await mkdtemp(path.join(tempBase, `${scanner}-${randomUUID()}-`));
  const home = path.join(tempRoot, "home");
  const temp = path.join(tempRoot, "tmp");
  const cache = path.join(tempRoot, "cache");
  await Promise.all([home, temp, cache].map((directory) => mkdir(directory, { mode: 0o700 })));
  const nodeBin = process.env.DEEP_AUDIT_NODE_BIN;
  const systemBin = process.env.DEEP_AUDIT_SYSTEM_BIN || "/usr/bin:/bin";
  const scannerPath = [
    nodeBin && path.isAbsolute(nodeBin) ? path.dirname(nodeBin) : null,
    path.join(scannerRoot, "bin"),
    path.join(scannerRoot, "python", "bin"),
    path.join(scannerRoot, "node", "node_modules", ".bin"),
    ...systemBin.split(path.delimiter),
  ].filter(Boolean).join(path.delimiter);
  let result;
  try {
    result = await new Promise((resolve, reject) => {
      const child = spawn(executable, args, {
        cwd: target,
        shell: false,
        detached: true,
        env: {
          PATH: scannerPath,
          HOME: home,
          TMPDIR: temp,
          TMP: temp,
          TEMP: temp,
          XDG_CACHE_HOME: cache,
          LANG: process.env.DEEP_AUDIT_SCANNER_LANG || "C",
          SEMGREP_SEND_METRICS: "off",
          SEMGREP_NO_ANALYTICS: "1",
          NO_COLOR: "1",
        },
        stdio: ["ignore", "pipe", "pipe"],
      });
      let stdout = "";
      let stderr = "";
      let timedOut = false;
      let outputTruncated = false;
      let forceKillTimer;
      const terminateGroup = () => {
        try { process.kill(-child.pid, "SIGTERM"); } catch { try { child.kill("SIGTERM"); } catch {} }
        forceKillTimer = setTimeout(() => { try { process.kill(-child.pid, "SIGKILL"); } catch {} }, 1500);
        forceKillTimer.unref();
      };
      const collect = (which) => (chunk) => {
        const value = chunk.toString();
        const previous = which === "stdout" ? stdout : stderr;
        const next = previous + value;
        if (next.length > OUTPUT_LIMIT && !outputTruncated) {
          outputTruncated = true;
          terminateGroup();
        }
        if (which === "stdout") stdout = next.slice(0, OUTPUT_LIMIT);
        else stderr = next.slice(0, OUTPUT_LIMIT);
      };
      child.stdout.on("data", collect("stdout"));
      child.stderr.on("data", collect("stderr"));
      const timer = setTimeout(() => { timedOut = true; terminateGroup(); }, 5 * 60 * 1000);
      const cleanup = () => { clearTimeout(timer); if (forceKillTimer) clearTimeout(forceKillTimer); };
      child.once("error", (error) => { cleanup(); reject(error); });
      child.once("close", (code, signal) => {
        clearTimeout(timer);
        if (!timedOut && !outputTruncated && forceKillTimer) clearTimeout(forceKillTimer);
        resolve({ exit_code: code ?? -1, signal: signal ?? null, timed_out: timedOut, output_truncated: outputTruncated, stdout, stderr });
      });
    });
  } finally {
    await rm(tempRoot, { recursive: true, force: true });
    try { await rmdir(tempBase); } catch (error) { if (!new Set(["ENOENT", "ENOTEMPTY"]).has(error?.code)) throw error; }
  }

  let sidecar = "";
  const sidecarPath = scanner === "gitleaks" ? `${output}.gitleaks.json` : scanner === "jscpd" ? path.join(runDir, "jscpd-report.json") : null;
  if (sidecarPath) {
    sidecar = await readFile(sidecarPath, "utf8").catch(() => "");
    if (sidecar) await chmod(sidecarPath, 0o600).catch(() => {});
  }
  const analysis = summarizedFindings(scanner, result, sidecar, target);
  if (scanner === "jscpd" && sidecarPath) await rm(sidecarPath, { force: true });
  if (scanner === "gitleaks" && sidecarPath) await rm(sidecarPath, { force: true });
  const root = path.relative(context.worktree ?? context.directory, target);
  const findingCount = analysis.finding_count ?? analysis.duplicate_count ?? analysis.result_count ?? analysis.findings?.length ?? 0;
  const fatalDiagnostic = (analysis.diagnostics ?? []).some((line) => /(?:^|\b)(?:fatal|error:|failed to|no such file|not found)\b/i.test(line));
  const status = result.timed_out || result.output_truncated || fatalDiagnostic || result.exit_code < 0
    ? "failed"
    : findingCount > 0
      ? "completed_with_findings"
      : result.exit_code === 0
        ? "completed"
        : "failed";
  const payload = redact(JSON.stringify({
    schema_version: 1,
    scanner,
    target: root,
    status,
    analysis_scope: { root, recursive: true, source_files_discovered: files.length, command: [executable, ...args] },
    exit_code: result.exit_code,
    signal: result.signal,
    timed_out: result.timed_out,
    output_truncated: result.output_truncated,
    stdout_bytes: Buffer.byteLength(result.stdout),
    stderr_bytes: Buffer.byteLength(result.stderr),
    ...(result.exit_code === 0 ? {} : { diagnostic: redact(result.stderr || result.stdout).slice(0, 4000) }),
    analysis,
  }, null, 2));
  await writeFile(output, `${payload}\n`, { encoding: "utf8", mode: 0o600, flag: "wx" });
  const title = status === "completed_with_findings"
    ? `${scanner} completed with findings (exit ${result.exit_code})`
    : status === "failed"
      ? `${scanner} failed (exit ${result.exit_code})`
      : `${scanner} completed (exit ${result.exit_code})`;
  return { title, output: `Scan evidence saved outside the target: ${output}\n\n${payload}` };
}

export default async () => {
  let activeTask;
  const allowedAgents = new Set([
    "audit-inventory", "audit-architecture", "audit-correctness", "audit-security",
    "audit-dependencies", "audit-performance", "audit-simplicity", "audit-tests", "audit-reviewer",
  ]);
  return {
    tool: {
      deep_audit_scan: tool({
      description: "Run one allowlisted profile-installed scanner on the active read-only target. No arbitrary commands or paths are accepted; output is saved outside the project.",
      args: {
        scanner: tool.schema.enum(["jscpd", "ast-grep", "semgrep", "gitleaks", "osv-scanner", "ruff", "vulture", "knip", "bandit", "pip-audit", "sqlfluff"]),
        sql_dialect: tool.schema.enum(["ansi", "mysql", "postgres", "sqlite", "tsql"]).default("ansi"),
      },
      async execute(args, context) { return executeScanner(args.scanner, args.sql_dialect, context); },
      }),
    },
    "tool.execute.before": async (input, output) => {
      const toolName = String(input.tool ?? "").toLowerCase();
      if (toolName === "call_omo_agent") throw new Error("Deep Audit forbids legacy/recursive OmO delegation; use an allowlisted native audit agent.");
      if (toolName !== "task") return;
      if (activeTask && activeTask.callID !== input.callID) throw new Error("Deep Audit concurrency guard: wait for the active foreground audit task to finish before launching another subagent.");
      if (!output.args || typeof output.args !== "object") throw new Error("Deep Audit task call has no arguments");
      const agent = String(output.args.subagent_type ?? output.args.agent ?? "");
      if (!allowedAgents.has(agent)) throw new Error(`Deep Audit task agent is not allowlisted: ${agent || "missing"}`);
      output.args.run_in_background = false;
      activeTask = { sessionID: input.sessionID, callID: input.callID, agent };
    },
    "tool.execute.after": async (input) => {
      if (String(input.tool ?? "").toLowerCase() !== "task") return;
      if (activeTask?.sessionID === input.sessionID && activeTask?.callID === input.callID) activeTask = undefined;
    },
  };
};
