{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@OMO_PLUGIN@",
    "@PACKAGE_ROOT@/teams/best/best-router-plugin.js",
    "@PACKAGE_ROOT@/shared/mac-notifications/plugin.js"
  ],
  "model": "opencode/step-5-preview-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "default_agent": "OpenCode-Builder",
  "subagent_depth": 1,
  "enabled_providers": ["opencode"],
  "disabled_providers": [
    "anthropic", "google", "openai", "chatgpt-subscription", "opencode-go",
    "opencode-omniroute", "openrouter", "bedrock", "vertex", "xai", "mistral",
    "groq", "cohere", "fireworks", "together", "deepinfra", "cerebras",
    "perplexity", "voyage", "ollama", "lmstudio", "litellm"
  ],
  "permission": { "*": "allow", "skill_mcp": "allow", "external_directory": "allow", "doom_loop": "allow" },
  "tools": { "call_omo_agent": false },
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "agent": {
    "OpenCode-Builder": {
      "prompt_append": "When BEST routing guidance contains <BEST_ROUTER_ROUTE>, obey it before any analysis: issue the exact native task call(s) named by the guidance with subagent_type and run_in_background=true. EXPLORE and LIBRARIAN require exactly one matching task; BOTH requires exactly one explore task and one librarian task; FOUR requires exactly one each of explore, librarian, openai-architect, and openai-reviewer, launched in parallel. Do not substitute agents, retry, launch duplicates, call call_omo_agent, or use repository/research tools before the required tasks are launched.",
      "permission": {
        "task": "allow",
        "call_omo_agent": "deny",
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow"
      },
      "tools": { "call_omo_agent": false }
    },
    "explore": {
      "model": "opencode/ling-3.1-flash-free",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "librarian": {
      "model": "opencode/ling-3.1-flash-free",
      "permission": {
        "serena_initial_instructions": "allow",
        "serena_get_current_config": "allow",
        "serena_get_symbols_overview": "allow",
        "serena_find_symbol": "allow",
        "serena_find_declaration": "allow",
        "serena_find_implementations": "allow",
        "serena_find_referencing_symbols": "allow",
        "serena_get_diagnostics_for_file": "allow",
        "serena_search_for_pattern": "allow",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "openai-architect": {
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "Analyze the requested complex implementation independently. Inspect relevant code and return a concise implementation plan, affected components, constraints, and risks. Do not edit files.",
      "permission": {
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    },
    "openai-reviewer": {
      "mode": "subagent",
      "model": "opencode/nemotron-3-ultra-free",
      "prompt": "Independently review the requested implementation requirements. Identify edge cases, compatibility concerns, and focused behavior checks. Do not edit files.",
      "permission": {
        "task": "deny",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "serena_replace_content": "deny",
        "serena_replace_in_files": "deny",
        "serena_replace_symbol_body": "deny",
        "serena_insert_before_symbol": "deny",
        "serena_insert_after_symbol": "deny",
        "serena_rename_symbol": "deny",
        "serena_safe_delete_symbol": "deny",
        "serena_write_memory": "deny",
        "serena_edit_memory": "deny",
        "serena_delete_memory": "deny",
        "serena_rename_memory": "deny"
      }
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  }
}
