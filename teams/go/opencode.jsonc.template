{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@OMO_PLUGIN@", "@PACKAGE_ROOT@/shared/mac-notifications/plugin.js"],
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "OpenCode-Builder",
  "permission": { "*": "allow", "skill_mcp": "allow", "external_directory": "allow", "doom_loop": "allow" },
  "disabled_providers": [
    "openai", "anthropic", "google", "opencode-omniroute", "openrouter", "bedrock",
    "vertex", "xai", "mistral", "groq", "cohere", "fireworks", "together",
    "deepinfra", "cerebras", "perplexity", "voyage", "ollama", "lmstudio", "litellm"
  ],
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "browser_automation_engine": {
    "provider": "playwright",
    "playwright_mcp_args": ["--headless", "--isolated", "--output-dir", "@DATA_ROOT@/go/playwright/output"]
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": { "options": { "max_tokens": 32768, "timeout": 300000 } }
  }
}
