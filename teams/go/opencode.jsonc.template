{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@OMO_PLUGIN@", "@PACKAGE_ROOT@/shared/mac-notifications/plugin.js"],
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "default_agent": "OpenCode-Builder",
  "permission": { "*": "allow", "skill_mcp": "allow", "external_directory": "allow", "doom_loop": "allow" },
  "disabled_providers": [
    "openai", "anthropic", "google", "opencode-omniroute", "openrouter", "bedrock",
    "vertex", "xai", "mistral", "groq", "cohere", "fireworks", "together",
    "deepinfra", "cerebras", "perplexity", "voyage", "ollama", "lmstudio", "litellm"
  ],
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  "browser_automation_engine": {
    "provider": "playwright",
    "playwright_mcp_args": ["--headless", "--isolated", "--output-dir", "@DATA_ROOT@/go/playwright/output"]
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["@SERENA_BIN@", "start-mcp-server", "--context", "ide", "--project-from-cwd", "--open-web-dashboard", "false"],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "mode": "subagent",
      "description": "GO subscription read-only repository explorer.",
      "model": "opencode-go/qwen3.7-plus",
      "prompt": "Explore the assigned repository scope using the GO subscription model. Return concise findings and paths; do not edit files.",
      "permission": { "edit": "deny", "write": "deny", "apply_patch": "deny", "bash": "deny", "task": "deny" },
      "tools": { "edit": false, "write": false, "apply_patch": false, "bash": false, "task": false }
    },
    "librarian": {
      "mode": "subagent",
      "description": "GO subscription documentation researcher.",
      "model": "opencode-go/qwen3.7-plus",
      "prompt": "Research the assigned documentation scope using the GO subscription model. Return source links and concise findings; do not edit files.",
      "permission": { "edit": "deny", "write": "deny", "apply_patch": "deny", "bash": "deny", "task": "deny" },
      "tools": { "edit": false, "write": false, "apply_patch": false, "bash": false, "task": false }
    }
  },
  "provider": {
    "opencode-go": { "options": { "max_tokens": 32768, "timeout": 300000 } }
  }
}
