SANDBOX=@DATA_ROOT@/openai
TMUX_PREFIX=oc-openai
OMO_PROFILE=openai-candidate
OPENCODE_CONFIG=@CONFIG_ROOT@/openai/opencode.jsonc
XDG_CONFIG_HOME_OVERRIDE=@CONFIG_ROOT@/openai/xdg-config
