#!/bin/bash
set -uo pipefail

CORE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  cat <<EOF
Usage: team-runtime --config <path-to-team-runtime.conf> [OPTIONS]

Shared OpenCode team runtime core.

Options:
  --config <path>   Path to team-runtime.conf (required)
  --resume <id>     Resume an existing session (ses_...)
  --help            Show this help
EOF
}

source "$CORE_DIR/lib/config.sh"
source "$CORE_DIR/lib/core.sh"

CONFIG_FILE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --config)
      CONFIG_FILE="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "$CONFIG_FILE" ]; then
  echo "ERROR: --config required" >&2
  usage >&2
  exit 1
fi

if [ "${TEAM_RUNTIME_INNER:-}" = "1" ]; then
  parse_team_config "$CONFIG_FILE" || exit 1
  main "$CONFIG_FILE"
  exit $?
fi

SESSION_MODE="new"
RESUME_SESSION_ID=""

while [ $# -gt 0 ]; do
  case "$1" in
    --resume|-s)
      SESSION_MODE="resume"
      RESUME_SESSION_ID="${2:-}"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$SESSION_MODE" = "resume" ]; then
  if [ -z "$RESUME_SESSION_ID" ] || [[ ! "$RESUME_SESSION_ID" =~ ^ses_[A-Za-z0-9]+$ ]]; then
    echo "ERROR: --resume requires a valid session ID (ses_...)" >&2
    exit 1
  fi
fi

parse_team_config "$CONFIG_FILE" || exit 1

RUN_ID=$("$OPENCODE_TEAM_PYTHON" -c "import secrets; print(secrets.token_hex(4))")

if [ -n "${TMUX:-}" ]; then
  export TEAM_RUNTIME_INNER=1
  export RUN_ID="$RUN_ID"
  export SESSION_MODE="$SESSION_MODE"
  export RESUME_SESSION_ID="$RESUME_SESSION_ID"
  main "$CONFIG_FILE"
else
  SESSION_NAME="${TMUX_PREFIX}-${RUN_ID}"
  echo "Starting tmux session: $SESSION_NAME (run=$RUN_ID)"
  COLS=$(tput cols 2>/dev/null || echo 120)
  LINES=$(tput lines 2>/dev/null || echo 30)
  tmux_env_args=()
  for auth_var in OPENCODE_AUTH_SOURCE OPENAI_CODEX_AUTH_SOURCE SSH_AUTH_SOCK SSH_AGENT_PID; do
    if [ "${!auth_var+x}" = x ]; then
      tmux_env_args+=(-e "$auth_var=${!auth_var}")
    fi
  done
  tmux new-session -d "${tmux_env_args[@]}" -s "$SESSION_NAME" -x "$COLS" -y "$LINES" \
    "TEAM_RUNTIME_INNER=1 RUN_ID=$RUN_ID SESSION_MODE=$SESSION_MODE RESUME_SESSION_ID=$RESUME_SESSION_ID bash $CORE_DIR/bin/team-runtime --config '$CONFIG_FILE'"
  exec tmux attach-session -t "$SESSION_NAME"
fi
